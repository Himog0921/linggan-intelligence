<main id="main" class="cr-main" tabindex="-1" aria-label="评论研究">
<section id="overview" class="view active" aria-label="评论研究概览">
<h1 class="sr-only">评论研究概览</h1>
<div class="overview-top">
<div class="ov-cell metric-col"><div class="data-stamp"><span>数据截至</span><span class="stamp-date"><span id="dataUpdatedAt">2026/11/20 18:39</span> <span data-icon="Info"></span></span></div><div class="metric-block"><div class="metric-title">可研究评论</div><div class="metric-number"><span id="metricEligible">24</span><small>条</small></div><div class="metric-sub"><span id="metricRaw"></span><span class="delta" title="上一完整自然日首次被观察的评论身份">↗ +8<small>昨日首次观察</small></span></div></div><div class="metric-block"><div class="metric-title">已进入研究</div><div class="metric-number"><span id="metricEntered"></span><small>条</small></div><div class="research-bar" id="researchBar" role="img"></div><div class="research-legend" id="researchLegend"></div><div class="metric-sub"><span id="metricResults"></span><span id="metricCoverage"></span></div></div></div>
<div class="ov-cell chart-col"><div class="chart-toolbar"><div class="legend"><span><i></i>首次观察评论</span><span><i class="line-key"></i>研究信号写入</span><span class="coverage-legend"><i class="full"></i>完整 <i class="part"></i>部分 <i class="none"></i>无记录</span></div><div class="chart-controls"><div class="range-group" aria-label="时间范围"><button data-range="fit" class="active" aria-pressed="true">有数据以来</button><button data-range="7" aria-pressed="false">近 7 天</button><button data-range="28" aria-pressed="false">近 28 天</button><button data-range="56" aria-pressed="false">近 56 天</button></div><div class="mode-group" aria-label="趋势呈现"><button data-chart-mode="chart" class="active" aria-pressed="true">图表</button><button data-chart-mode="table" aria-pressed="false">表格</button></div></div></div><div class="chart-wrap" id="trendChart"></div><div class="chart-table" id="trendTable" hidden></div><div class="chart-status" id="chartStatus"></div></div>
<div class="ov-cell ov-row2 metric-col"><div class="metric-pair"><div><div class="metric-title">当前研究信号</div><div class="metric-number"><span id="metricSignals"></span><small>条</small></div><div class="metric-sub"><span>来自当前有效结果</span></div><div class="metric-sub"><span class="delta">↗ +6<small>昨日写入</small></span></div></div><div><div class="metric-title">长期用户问题</div><div class="metric-number"><span id="metricProblems"></span><small>个</small></div><div class="metric-sub"><span id="metricProblemState"></span></div><div class="metric-sub"><span class="delta">↗ +1<small>昨日建档</small></span></div></div></div><button class="candidate-link" id="candidateShortcut"><span id="candidateText"></span><span data-icon="ArrowRight"></span></button></div>
<div class="ov-cell ov-row2 chart-col"><div class="expression"><div class="expression-head"><div><strong>领域高频表达</strong> <small>评论原声中的短语 · 非用户问题判定</small></div><div class="tabs" aria-label="表达类型"><button data-word="all" class="active" aria-pressed="true">全部表达</button><button data-word="困难场景" aria-pressed="false">困难场景</button><button data-word="情绪体验" aria-pressed="false">情绪体验</button><button data-word="办法与经历" aria-pressed="false">办法与经历</button></div></div><div class="wordcloud" id="wordcloud"></div><div class="word-hint">选择短语，查看相关评论</div></div></div>
</div>
<div class="overview-lower"><section><h2 class="section-title">已有依据的用户问题 <small>按独立作者支持</small></h2><div id="overviewProblems"></div></section><section><h2 class="section-title">近期研究信号 <small>依据评论原声</small></h2><div id="recentSignals"></div></section></div>
</section>
<section id="comments" class="view" aria-labelledby="commentsTitle">
<header class="section-head"><h1 id="commentsTitle">用户评论</h1><p id="commentsMeta"></p></header>
<div class="toolbar"><div class="field search-field"><label for="search">字面搜索</label><div class="search-shell"><button type="button" class="find" id="searchButton">搜索</button><select id="searchScope" aria-label="搜索范围"><option value="comment">评论文本</option><option value="work">作品标题</option></select><input type="search" id="search" autocomplete="off" placeholder="搜索评论原声"></div></div><div class="field"><label for="statusFilter">研究状态</label><select id="statusFilter"><option value="all">全部</option><option value="never">尚未研究</option><option value="running">进行中</option><option value="result">已有结果</option><option value="needs_context">需要语境</option><option value="failed">最近失败</option></select></div><div class="field"><label for="tagFilter">研究标签</label><select id="tagFilter"><option value="all">全部标签</option><option>困难场景</option><option>情绪体验</option><option>办法与经历</option><option value="no_signal">无研究信号</option></select></div><div class="field"><label for="commentSort">排序</label><select id="commentSort"><option value="likes">点赞最多</option><option value="recent">最新观察</option></select></div><button type="button" class="btn" id="advancedButton" aria-expanded="false" aria-controls="advancedFilters"><span data-icon="SlidersHorizontal"></span>筛选</button><button type="button" class="btn" id="selectMode" aria-pressed="false"><span data-icon="ListChecks"></span>选择评论</button></div>
<div id="advancedFilters" class="advanced" hidden><div class="field"><label for="minLikes">最低点赞</label><input type="number" id="minLikes" min="0" step="1" placeholder="不限"></div><div class="field"><label for="markFilter">改帖标记</label><select id="markFilter"><option value="all">全部</option><option value="marked">已标记</option><option value="unmarked">未标记</option></select></div><button class="btn quiet" id="clearFilters">清除筛选</button></div>
<div class="result-line"><span id="commentCount" role="status" aria-live="polite"></span><span id="commentContext"></span></div>
<div class="table-wrap"><table class="comment-table"><caption class="sr-only">评论原声与研究结果</caption><colgroup id="commentCols"></colgroup><thead><tr><th scope="col" class="check-cell" id="checkHead" hidden><input class="table-check" id="selectAll" type="checkbox" aria-label="选择当前筛选的全部评论"></th><th scope="col">原声</th><th scope="col" class="numeric">点赞</th><th scope="col">所属作品</th><th scope="col">研究状态</th><th scope="col">研究标签</th><th scope="col">作者</th><th scope="col">点赞采集日</th><th scope="col">观测时间</th><th scope="col" class="center">改帖</th></tr></thead><tbody id="commentRows"></tbody></table></div>
<div class="table-foot"><span>点击评论，查看原声与研究证据</span><span id="commentPageMeta"></span></div>
<div class="selection-bar" id="selectionBar" hidden><div><div class="selection-info"><strong id="selectedSummary"></strong><span id="selectedScale"></span></div><div class="selection-detail" id="selectedDetail"></div></div><div class="selection-actions"><button type="button" class="btn quiet" id="clearSelection">清空选择</button><button type="button" class="btn primary" id="previewButton">预览研究计划 <span data-icon="ArrowRight"></span></button></div></div><div id="selectionAnnouncement" class="sr-only" role="status" aria-live="polite"></div>
</section>
<section id="problems" class="view" aria-labelledby="problemsTitle"><h1 class="sr-only" id="problemsTitle">用户问题</h1><div class="pa-page"><div class="pa-toolbar"><div class="search-shell pa-search-shell"><button type="button" class="find" id="problemSearchButton">搜索</button><input id="problemSearch" type="search" aria-label="搜索问题名称或描述" placeholder="搜索问题名称或描述"></div><div class="pa-controls"><div class="seg" role="group" aria-label="问题状态"><button type="button" data-pstate="all" aria-pressed="true">全部 <b id="pcAll"></b></button><button type="button" data-pstate="formal" aria-pressed="false" title="正式问题：至少 2 位不同作者提到">正式 <b id="pcFormal"></b></button><button type="button" data-pstate="candidate" aria-pressed="false" title="候选问题：目前只有 1 位作者提到">候选 <b id="pcCandidate"></b></button></div><select id="problemStatus" hidden aria-hidden="true" tabindex="-1"><option value="all">全部</option><option value="formal">正式</option><option value="candidate">候选</option></select><div class="inline-field"><label for="problemSort">排序</label><select id="problemSort"><option value="recent">最新研究</option><option value="authors">作者数量</option><option value="comments">评论数量</option><option value="works">作品数量</option></select></div></div></div><p class="pa-result" id="problemCount" aria-live="polite"></p><div class="pa-grid" id="problemGrid"></div></div></section>
</main>