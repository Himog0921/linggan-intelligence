  const comments = [
    comment('C-001', '书包打开了，笔也拿在手里了，还是要我一遍遍提醒才肯写第一题。每天最累的不是讲题，是陪他开始。', 3580, 'W-01', '林林妈妈', 'A-01', '2026-11-19T09:12:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('困难场景', '家长需要反复提醒，孩子才能从准备阶段进入作业行动。', '还是要我一遍遍提醒才肯写第一题。', 'P-008')),
    comment('C-002', '他说知道要写，也知道先写哪一科，可是坐了二十分钟纸上还是空的。我以前一直以为他是在故意拖。', 2416, 'W-01', '小岛妈妈', 'A-02', '2026-11-19T09:26:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('困难场景', '知道任务顺序并未转化为行动，任务启动仍需要支持。', '坐了二十分钟纸上还是空的。', 'P-008')),
    comment('C-003', '后来我们只约定先把日期写上，不说把整张卷子做完，他反而愿意动笔了。第一步真的要小一点。', 1850, 'W-02', '木木妈', 'A-03', '2026-11-18T20:14:00+08:00', { state: 'failed', runId: 'R-1120-04', failure: '本次请求超时，尚未取得新的结果。此前有效结果保留。' }, signal('办法与经历', '把任务缩小为写日期这一可执行动作，有助于启动作业。', '先把日期写上，不说把整张卷子做完，他反而愿意动笔了。', 'P-008')),
    comment('C-004', '我家是每一步都等人说。换成三格小清单后，他会自己看看下一步是什么，至少开头不用一直催。', 1723, 'W-02', '慢慢学就好', 'A-04', '2026-11-18T19:43:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('办法与经历', '可见的小清单减少了启动任务时对家长指令的依赖。', '换成三格小清单后，他会自己看看下一步是什么', 'P-008')),
    comment('C-005', '昨天换了个方法，先陪他写两分钟再离开，比隔着客厅喊快写作业有用。还是得有人帮他迈出第一步。', 1480, 'W-01', '林林妈妈', 'A-01', '2026-11-19T10:02:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('办法与经历', '短时间共同启动，比远距离催促更容易帮助孩子开始作业。', '先陪他写两分钟再离开，比隔着客厅喊快写作业有用。', 'P-008')),
    comment('C-006', '刚进入状态，手机一响就完全断了。把手机放远只能少打断几次，重新坐回去还是要缓很久。', 1368, 'W-03', '北北的日常', 'A-05', '2026-11-19T10:18:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('困难场景', '外部提醒打断专注后，重新进入任务需要较长时间。', '重新坐回去还是要缓很久。', 'P-014')),
    comment('C-007', '我也试过分成十分钟，开始还行，中间有人叫一下，后面那一段就接不回去了。', 1155, 'W-02', '北北的日常', 'A-05', '2026-11-19T10:36:00+08:00', { state: 'succeeded', runId: 'R-1119-01' }, signal('困难场景', '即使任务已经分段，中断后仍难以恢复连续投入。', '中间有人叫一下，后面那一段就接不回去了。', 'P-014')),
