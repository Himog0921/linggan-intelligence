      works: new Set(evidence.map(function (item) { return item.workId; })).size,
      state: authorCount >= 2 ? 'formal' : 'candidate',
      evidenceIds: evidence.map(function (item) { return item.id; })
    });
  });

  function completedUnit(id, workId, commentIds) {
    const targets = commentIds.map(function (commentId) { return comments.find(function (item) { return item.id === commentId; }); });
    return {
      id, workId, commentIds, state: 'completed',
      signalCount: targets.filter(function (item) { return item.currentResult && item.currentResult.outcome === 'signals'; }).length,
      contextCount: targets.filter(function (item) { return item.currentResult && item.currentResult.outcome === 'needs_context'; }).length,
      noSignalCount: targets.filter(function (item) { return item.currentResult && item.currentResult.outcome === 'no_signal'; }).length,
      error: null
    };
  }
  function pendingUnit(id, workId, commentIds, state, error) {
    return { id, workId, commentIds, state, signalCount: 0, contextCount: 0, noSignalCount: 0, error: error || null };
  }
  const runs = [
    { id: 'R-1120-05', createdAt: '2026-11-20T18:32:00+08:00', state: 'running', units: [pendingUnit('U-05-01', 'W-01', ['C-021'], 'running'), pendingUnit('U-05-02', 'W-03', ['C-022'], 'queued')], usage: { calls: 1, inputTokens: 1048, outputTokens: 0 } },
    { id: 'R-1120-04', createdAt: '2026-11-20T18:26:00+08:00', state: 'partial', units: [pendingUnit('U-04-01', 'W-02', ['C-003'], 'failed', '请求超时，未取得新结果；原有效结果保留。'), completedUnit('U-04-02', 'W-05', ['C-011', 'C-013'])], usage: { calls: 2, inputTokens: 2314, outputTokens: 816 } },
    { id: 'R-1120-03', createdAt: '2026-11-20T18:12:00+08:00', state: 'completed', units: [completedUnit('U-03-01', 'W-04', ['C-008', 'C-009']), completedUnit('U-03-02', 'W-05', ['C-010']), completedUnit('U-03-03', 'W-06', ['C-012', 'C-016'])], usage: { calls: 3, inputTokens: 3876, outputTokens: 1694 } },
    { id: 'R-1120-02', createdAt: '2026-11-20T17:58:00+08:00', state: 'failed', units: [pendingUnit('U-02-01', 'W-05', ['C-023'], 'failed', '返回内容不完整，未写入研究结果。')], usage: { calls: 1, inputTokens: 984, outputTokens: 126 } },
    { id: 'R-1119-01', createdAt: '2026-11-19T14:12:00+08:00', state: 'completed', units: [completedUnit('U-01-01', 'W-01', ['C-001', 'C-002', 'C-005', 'C-014']), completedUnit('U-01-02', 'W-02', ['C-003', 'C-004', 'C-007']), completedUnit('U-01-03', 'W-03', ['C-006', 'C-015'])], usage: { calls: 3, inputTokens: 4102, outputTokens: 2187 } }
  ];

  /* Stable selection IDs, grouped by work. Each ready unit contains at most 20 comments.
     Active comments and works without L1 are excluded from this submission only.
     A previously successful comment remains eligible for another research attempt. */
  function derivePlan(ids, commentsOverride = comments) {
    const requested = new Set(Array.from(ids || []));
    const selected = commentsOverride.filter(function (item) { return requested.has(item.id); });
    const groupsByWork = new Map();
    selected.forEach(function (item) {
      if (!groupsByWork.has(item.workId)) {
        groupsByWork.set(item.workId, { workId: item.workId, commentIds: [], eligibleIds: [], waitingIds: [], activeIds: [], unitsCount: 0 });
      }
      const group = groupsByWork.get(item.workId);
      const work = works.find(function (record) { return record.id === item.workId; });
      group.commentIds.push(item.id);
      if (item.latestExecution && item.latestExecution.state === 'running') group.activeIds.push(item.id);
      else if (!work || !work.l1Ready) group.waitingIds.push(item.id);
      else { group.eligibleIds.push(item.id); if (item.currentResult) (group.rerunIds = group.rerunIds || []).push(item.id); }
    });
    const groups = Array.from(groupsByWork.values());
    const units = [];
    groups.forEach(function (group) {
      for (let start = 0; start < group.eligibleIds.length; start += 20) {
        units.push({ workId: group.workId, commentIds: group.eligibleIds.slice(start, start + 20) });
      }
      group.unitsCount = Math.ceil(group.eligibleIds.length / 20);
    });
    const waitingIds = groups.flatMap(function (group) { return group.waitingIds; });
    const activeIds = groups.flatMap(function (group) { return group.activeIds; });
    const researchableCount = units.reduce(function (total, unit) { return total + unit.commentIds.length; }, 0);
    const rerunIds = groups.flatMap(function (group) { return group.rerunIds || []; });
    return {
      selectedCount: selected.length,
      researchableCount,
      excludedCount: waitingIds.length + activeIds.length,
      waitingCount: waitingIds.length,
      activeCount: activeIds.length,
      workCount: groups.length,
      unitCount: units.length,
      callCount: units.length,
      rerunCount: rerunIds.length,
      groups, units, waitingIds, activeIds, rerunIds
    };
  }

  function summarize() {
    const results = comments.filter(function (item) { return Boolean(item.currentResult); });
    const allPlan = derivePlan(comments.map(function (item) { return item.id; }));
    return {
      // All 24 synthetic comments have been indexed and passed semantic eligibility.
      total: comments.length, indexed: comments.length, eligible: comments.length,
      // entered: ever submitted, including current failures and active executions.
      entered: comments.filter(function (item) { return item.latestExecution.state !== 'never'; }).length,
      // studied: a current successful result exists; a later failed retry does not remove it.
      studied: results.length,
      signals: results.filter(function (item) { return item.currentResult.outcome === 'signals'; }).length,
      needsContext: results.filter(function (item) { return item.currentResult.outcome === 'needs_context'; }).length,
      noSignal: results.filter(function (item) { return item.currentResult.outcome === 'no_signal'; }).length,
      researchable: allPlan.researchableCount,
      waiting: allPlan.waitingCount,
      activeComments: allPlan.activeCount,
      failedComments: comments.filter(function (item) { return item.latestExecution.state === 'failed'; }).length,
      works: works.length,
      problems: problems.length,
      formal: problems.filter(function (item) { return item.state === 'formal'; }).length,
      candidate: problems.filter(function (item) { return item.state === 'candidate'; }).length,
      activeRuns: runs.filter(function (item) { return item.state === 'running'; }).length,
      attentionRuns: runs.filter(function (item) { return item.state === 'failed' || item.state === 'partial'; }).length,
      runningNoResult: comments.filter(function (item) { return !item.currentResult && item.latestExecution.state === 'running'; }).length,
      failedNoResult: comments.filter(function (item) { return !item.currentResult && item.latestExecution.state === 'failed'; }).length,
      never: comments.filter(function (item) { return item.latestExecution.state === 'never'; }).length,
      coverage: comments.length ? Math.round(results.length / comments.length * 1000) / 10 : 0
    };
  }

  window.DemoData = { works, comments, problems, runs, derivePlan, get summary() { return summarize(); } };
}());

const PA_PIX={
 "0":["11111","10001","10011","10101","11001","10001","11111"],"1":["00100","01100","00100","00100","00100","00100","01110"],
 "2":["11110","00001","00001","01110","10000","10000","11111"],"3":["11110","00001","00001","01110","00001","00001","11110"],
 "4":["10010","10010","10010","11111","00010","00010","00010"],"5":["11111","10000","10000","11110","00001","00001","11110"],
 "6":["01111","10000","10000","11110","10001","10001","01110"],"7":["11111","00001","00010","00100","01000","01000","01000"],
 "8":["01110","10001","10001","01110","10001","10001","01110"],"9":["01110","10001","10001","01111","00001","00001","11110"],
 "A":["01110","10001","10001","11111","10001","10001","10001"],"B":["11110","10001","10001","11110","10001","10001","11110"],
 "C":["01111","10000","10000","10000","10000","10000","01111"],"F":["11111","10000","10000","11110","10000","10000","10000"],
 "K":["10001","10010","10100","11000","10100","10010","10001"]
};
function paPixelSVG(code){
 const cell=6.1;let rects="";
 [...code].forEach((ch,ci)=>{const rows=PA_PIX[ch]||PA_PIX["0"];rows.forEach((row,ri)=>{[...row].forEach((bit,bi)=>{if(bit==="1"){const x=ci*37.8+bi*cell,y=ri*cell;rects+=`<rect x="${x}" y="${y}" width="${cell-.7}" height="${cell-.7}" rx=".3"/>`;}});});});
 const width=code.length*37.8-7.3;
 return `<svg viewBox="0 0 ${width} 44" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g style="fill:var(--lgi-cr-banner-pixel)" opacity=".96">${rects}</g></svg>`;
}

