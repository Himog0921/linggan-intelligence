/* Standalone local prototype. All interactions use the embedded synthetic dataset. */
window.App = (function () {
  'use strict';
  const data = window.DemoData;
  const el = id => document.getElementById(id);
  const state = { view:'overview', selecting:false, selected:new Set(), workId:null, problemId:null, days:'fit', chartMode:'chart', word:'all', previewIds:new Set(), previewReturn:null, inspector:null, inspectorHistory:[], scroll:{overview:0,comments:0,problems:0}, currentEnd:'2026-11-20', updatedAt:'2026-11-20T18:39:00+08:00', simulation:null, submitting:false };
  const modalMeta = new WeakMap();
  let toastTimer, runSequence = 6;
  const escape = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fmt = n => Number(n || 0).toLocaleString('zh-CN');
  function date(value) { const d=new Date(value);if(Number.isNaN(d.getTime()))return '—';const p=Object.fromEntries(new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Taipei',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(d).map(x=>[x.type,x.value]));return `${p.year}/${p.month}/${p.day} ${p.hour}:${p.minute}`; }
  function icon(name) { return '<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(ICONS[name]||ICONS.Info).map(([tag,attrs])=>'<'+tag+' '+Object.entries(attrs).map(([k,v])=>k+'="'+escape(v)+'"').join(' ')+'></'+tag+'>').join('')+'</svg>'; }
  function fillIcons(root=document) { root.querySelectorAll('span[data-icon]').forEach(n=>{n.innerHTML=icon(n.dataset.icon);n.removeAttribute('data-icon');}); }
  const work = id => data.works.find(w=>w.id===id);
  const comment = id => data.comments.find(c=>c.id===id);
  const problem = id => data.problems.find(p=>p.id===id);
  const selectedPlan = () => data.derivePlan(state.selected);
  function focusDescriptor(node) {
    if(!(node instanceof HTMLElement))return null;
    if(node.id)return {id:node.id};
    const keys=['data-select-id','data-comment-id','data-problem-id','data-mark-id','data-related-comment','data-related-problem','data-work-filter','data-word-query'];
    const key=keys.find(k=>node.hasAttribute(k));return key?{key,value:node.getAttribute(key),tag:node.tagName}:null;
  }
  function resolveFocus(ref) {
    if(!ref)return null;if(ref.id)return el(ref.id);
    return [...document.querySelectorAll('['+ref.key+']')].find(n=>n.tagName===ref.tag&&n.getAttribute(ref.key)===ref.value&&!n.closest('.view:not(.active)')&&!n.closest('dialog:not([open])'))||null;
  }
  const visibleComments = () => {
    const q=el('search').value.trim().toLowerCase(), scope=el('searchScope').value, status=el('statusFilter').value, tag=el('tagFilter').value, min=Math.max(0,Number(el('minLikes').value)||0), mark=el('markFilter').value;
    return data.comments.filter(c=>{
      const r=c.currentResult,s=c.latestExecution.state,t=scope==='work'?work(c.workId).title:c.text;
      return (!q||t.toLowerCase().includes(q))&&(!state.workId||c.workId===state.workId)&&(!state.problemId||(r?.outcome==='signals'&&r.problemId===state.problemId))&&c.likes>=min&&(mark==='all'||(mark==='marked'?c.marked:!c.marked))&&
        (tag==='all'||(tag==='no_signal'?r?.outcome==='no_signal':r?.kind===tag))&&
        (status==='all'||(status==='result'?!!r:status==='needs_context'?r?.outcome==='needs_context':s===status));
    }).sort((a,b)=>el('commentSort').value==='recent'?b.observedAt.localeCompare(a.observedAt):b.likes-a.likes);
  };
  function statusInfo(c) {
    if(c.latestExecution.state==='running')return {label:c.currentResult?'研究中 · 有结果':'研究中',cls:'running'};
    if(c.latestExecution.state==='failed')return {label:c.currentResult?'最近失败 · 有结果':'最近失败',cls:'bad'};
    if(c.currentResult?.outcome==='needs_context')return {label:'需要语境',cls:'wait'};
    if(c.currentResult?.outcome==='no_signal')return {label:'已研究 · 无信号',cls:'good'};
    if(c.currentResult)return {label:'已有结果',cls:'good'};
    return {label:'尚未研究',cls:''};
  }
  function recomputeProblems() {
    data.problems.forEach(p=>{
      const evidence=data.comments.filter(c=>c.currentResult?.outcome==='signals'&&c.currentResult.problemId===p.id);
      p.evidenceIds=evidence.map(c=>c.id);p.authors=new Set(evidence.map(c=>c.authorId).filter(Boolean)).size;p.comments=evidence.length;p.works=new Set(evidence.map(c=>c.workId)).size;p.state=p.authors>=2?'formal':'candidate';
    });
  }
  function toast(message) {
    clearTimeout(toastTimer);const node=el('toast'), dialogs=[...document.querySelectorAll('dialog[open]')];(dialogs.at(-1)||document.body).appendChild(node);node.textContent=message;node.hidden=false;
    toastTimer=setTimeout(()=>{node.hidden=true;document.body.appendChild(node);},3500);
  }
  function openModal(dialog,trigger) {
    if(dialog.open)return;
    document.querySelectorAll('dialog[open]').forEach(other=>closeModal(other,{restore:false}));
    const focusTarget=trigger instanceof HTMLElement?trigger:document.activeElement;
    modalMeta.set(dialog,{trigger:focusTarget,focusRef:focusDescriptor(focusTarget),restore:true});
    document.body.classList.add('modal-open');dialog.showModal();
    if(dialog.id==='recordsDialog')el('recordsEntry').setAttribute('aria-expanded','true');
  }
  function closeModal(dialog,options={}) {
    if(!dialog.open)return;const meta=modalMeta.get(dialog);if(meta&&options.restore===false)meta.restore=false;dialog.close();
  }
  function initializeModals() {
    document.querySelectorAll('dialog').forEach(dialog=>{
      dialog.addEventListener('cancel',event=>{event.preventDefault();if(dialog.id==='previewDialog')closePreview();else closeModal(dialog);});
      dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom){if(dialog.id==='previewDialog')closePreview();else closeModal(dialog);}});
      dialog.addEventListener('close',()=>{
        document.body.classList.toggle('modal-open',!!document.querySelector('dialog[open]'));
        if(dialog.id==='recordsDialog')el('recordsEntry').setAttribute('aria-expanded','false');
        if(dialog.contains(el('toast')))document.body.appendChild(el('toast'));
        const meta=modalMeta.get(dialog);
        if(meta?.restore&&!document.querySelector('dialog[open]')){
          let target=meta.trigger?.isConnected?meta.trigger:resolveFocus(meta.focusRef);
          if(!target?.isConnected||target.closest('dialog:not([open])')||target.closest('.view:not(.active)'))target=el('recordsEntry');
          target.focus({preventScroll:true});
        }
      });
    });
  }
  function switchView(view,opts={}) {
    if(!['overview','comments','problems'].includes(view))return;
    state.scroll[state.view]=document.getElementById('main').scrollTop;state.view=view;
    document.querySelectorAll('.view').forEach(n=>n.classList.toggle('active',n.id===view));
    document.querySelectorAll('[data-view]').forEach(b=>{const active=b.dataset.view===view;b.classList.toggle('active',active);if(active)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current');});
    el('crumbView').textContent=({overview:'概览',comments:'用户评论',problems:'用户问题'})[view];
    document.title=el('crumbView').textContent+' · 评论研究 · Linggan Intelligence';
    if(view==='comments')renderComments();if(view==='problems')renderProblems();
    document.getElementById('main').scrollTo({top:opts.top?0:(state.scroll[view]||0),behavior:'instant'});
  }
  function renderOverview() {
    const s=data.summary;
    el('dataUpdatedAt').textContent=date(state.updatedAt);
    el('metricEligible').textContent=fmt(s.eligible);el('metricRaw').textContent=`已有 ${fmt(s.total)} 条原始评论 · ${fmt(s.total-s.indexed)} 条待索引`;
    el('metricEntered').textContent=fmt(s.entered);el('metricResults').textContent=`${fmt(s.studied)} 条已有结果`;el('metricCoverage').textContent=`结果覆盖 ${s.coverage}%`;
    renderResearchBar(s);el('metricSignals').textContent=fmt(s.signals);el('metricProblems').textContent=fmt(data.problems.length);el('metricProblemState').textContent=`正式 ${s.formal} · 候选 ${s.candidate}`;
    el('candidateText').textContent=`${s.candidate} 个候选问题等待独立支持`;
    el('recentSignals').innerHTML=data.comments.filter(c=>c.currentResult?.outcome==='signals').slice().sort((a,b)=>b.observedAt.localeCompare(a.observedAt)).slice(0,3).map(c=>`<div class="signal-row"><div><p>${escape(c.currentResult.proposition)}</p><small>${escape(c.currentResult.kind)} · ${escape(c.author)}</small></div><button class="btn quiet small" data-comment-id="${c.id}" aria-label="查看${escape(c.author)}的原声">原声 ${icon('ArrowUpRight')}</button></div>`).join('');
    el('overviewProblems').innerHTML=data.problems.slice().sort((a,b)=>b.authors-a.authors).slice(0,2).map(p=>`<div class="problem-row"><div><p>${escape(p.title)}</p><small>${p.state==='formal'?'正式问题':'候选问题'} · ${p.authors} 位作者 · ${p.works} 篇作品</small></div><button class="btn small" data-problem-id="${p.id}">查看证据</button></div>`).join('');
    renderTrend();renderWords();
  }
  function researchSegments(s) {
    return [['有结果',s.studied,'done'],['研究中',s.runningNoResult,'running'],['最近失败',s.failedNoResult,'failed'],['未研究',s.never,'never']];
  }
  function renderResearchBar(s) {
    const seg=researchSegments(s),total=Math.max(1,s.total);
    el('researchBar').innerHTML=seg.map(([label,n,cls])=>n?`<i class="${cls}" style="width:${n/total*100}%" title="${label} ${fmt(n)} 条"></i>`:'').join('');
    el('researchBar').setAttribute('aria-label',`可研究评论 ${fmt(s.total)} 条：`+seg.map(([label,n])=>`${label} ${fmt(n)} 条`).join('，'));
    el('researchLegend').innerHTML=seg.map(([label,n,cls])=>`<span><i class="${cls}"></i>${label} <b>${fmt(n)}</b></span>`).join('');
  }
  function rangeDays() {
    if(state.days!=='fit')return state.days;
    const first=data.comments.map(c=>c.observedAt.slice(0,10)).sort()[0];
    const span=Math.round((Date.parse(state.currentEnd)-Date.parse(first))/864e5)+1;
    return Math.max(7,span+2);
  }
  function dayData() {
    const end=new Date(state.currentEnd+'T00:00:00Z'),rows=[];
    for(let i=rangeDays()-1;i>=0;i--){const day=new Date(end);day.setUTCDate(day.getUTCDate()-i);const key=day.toISOString().slice(0,10);rows.push({date:key,comments:data.comments.filter(c=>c.observedAt.slice(0,10)===key).length,signals:0,coverage:'无记录'});}
    data.runs.forEach(r=>r.units.filter(u=>u.state==='completed').forEach(u=>{const day=date(u.finishedAt||r.createdAt).slice(0,10).replaceAll('/','-');const row=rows.find(x=>x.date===day);if(row)row.signals+=u.signalCount||0;}));
    rows.forEach(row=>{const c=data.comments.filter(x=>x.observedAt.slice(0,10)===row.date);row.coverage=c.length?(c.every(x=>work(x.workId).l1Ready)?'完整':'部分'):'无记录';});return rows;
  }
  function renderTrend() {
    const rows=dayData(),maxC=Math.max(2,...rows.map(x=>x.comments)),maxS=Math.max(2,...rows.map(x=>x.signals));
    const ceilMax=n=>Math.ceil(n/2)*2,cMax=ceilMax(maxC),sMax=ceilMax(maxS),left=44,right=952,top=20,bottom=145,w=right-left,h=bottom-top,step=w/rows.length;
    const points=rows.map((r,i)=>[left+(i+.5)*step,bottom-h*r.signals/sMax]);let path=`M${points[0][0]},${points[0][1]}`;
    for(let i=1;i<points.length;i++){const a=points[i-1],b=points[i],mid=(a[0]+b[0])/2;path+=` C${mid},${a[1]} ${mid},${b[1]} ${b[0]},${b[1]}`;}
    const area=path+` L${points.at(-1)[0]},${bottom} L${points[0][0]},${bottom} Z`;
    const tickIndexes=[...new Set([0,Math.floor((rows.length-1)*.25),Math.floor((rows.length-1)*.5),Math.floor((rows.length-1)*.75),rows.length-1])];
    const cTotal=rows.reduce((n,r)=>n+r.comments,0),sTotal=rows.reduce((n,r)=>n+r.signals,0);
    el('trendChart').innerHTML=`<svg viewBox="0 0 1000 190" preserveAspectRatio="none" role="img" aria-label="${state.days==='fit'?'自最早数据起':'近'+state.days+'天'}，首次观察${cTotal}条评论，写入${sTotal}条研究信号。可切换表格查看逐日数据。"><defs><linearGradient id="signalFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" style="stop-color:var(--lgi-signal)" stop-opacity=".17"/><stop offset="100%" style="stop-color:var(--lgi-signal)" stop-opacity="0"/></linearGradient></defs><g font-size="12" font-family="inherit" style="fill:var(--lgi-muted)"><text x="0" y="11">评论</text><text x="967" y="11">信号</text>${[0,.5,1].map(f=>`<path d="M${left} ${bottom-h*f}H${right}" style="stroke:var(--lgi-hairline)" stroke-width="1"/><text x="32" y="${bottom-h*f+4}" text-anchor="end">${cMax*f}</text><text x="964" y="${bottom-h*f+4}">${sMax*f}</text>`).join('')}</g><path d="${area}" fill="url(#signalFill)"/>${rows.map((r,i)=>r.comments?`<rect x="${left+(i+.5)*step-Math.min(10,step*.42)/2}" y="${bottom-h*r.comments/cMax}" width="${Math.min(10,step*.42)}" height="${h*r.comments/cMax}" style="fill:var(--lgi-ink)"><title>${r.date} · 首次观察 ${r.comments} 条评论</title></rect>`:'').join('')}<path d="${path}" style="stroke:var(--lgi-signal)" stroke-width="2" vector-effect="non-scaling-stroke" fill="none"/>${rows.map((r,i)=>`<rect x="${left+i*step}" y="154" width="${Math.max(1,step-1)}" height="5" style="fill:${r.coverage==='完整'?'var(--lgi-body)':r.coverage==='部分'?'var(--lgi-warning-dot)':'var(--lgi-unknown-soft)'}" ><title>${r.date} · ${r.coverage}</title></rect>`).join('')}<g font-size="12" style="fill:var(--lgi-muted)">${tickIndexes.map(i=>`<text x="${left+(i+.5)*step}" y="181" text-anchor="${i===0?'start':i===rows.length-1?'end':'middle'}">${rows[i].date.slice(5)}</text>`).join('')}</g></svg>`;
    el('trendTable').innerHTML=`<table><caption class="sr-only">每日评论与研究信号</caption><thead><tr><th scope="col">日期</th><th scope="col" class="num">首次观察评论</th><th scope="col" class="num">研究信号写入</th><th scope="col">完整性</th></tr></thead><tbody>${rows.slice().reverse().map(r=>`<tr><td>${r.date}</td><td class="num">${r.comments}</td><td class="num">${r.signals}</td><td>${r.coverage}</td></tr>`).join('')}</tbody></table>`;
    el('trendChart').hidden=state.chartMode!=='chart';el('trendTable').hidden=state.chartMode!=='table';
    el('chartStatus').textContent=`${rows[0].date.replaceAll('-','/')} — ${rows.at(-1).date.replaceAll('-','/')} · 按日汇总${state.days==='fit'?' · 从最早一条评论前两天开始':''}`;
  }
  function renderWords() {
    // 设计稿示意：落地时由后端做短语级抽取并去掉虚词；这里用短语 + 命中关键词模拟。
    const phrases=[['开始不了',['开始','第一题','动笔','空的']],['一遍遍提醒',['提醒','催','等人说']],['第一步小一点',['第一步','日期','三格','只写了三个']],['陪写两分钟',['陪他写','陪写']],['一响就断了',['一响','叫一下','接不回去','脚步声']],['不知道改哪里',['改哪里','哪一步','打一个叉','为什么改']],['反馈等太久',['三天','周末','攒到']],['换个问法就忘',['换了个方向','又不会','用上']],['陪到很累',['累','发火','气氛']],['固定放一个地方',['篮子','放进同一个']]];
    const pool=data.comments.filter(c=>state.word==='all'||c.currentResult?.kind===state.word);
    const counts=phrases.map(([word,keys])=>({word,count:pool.filter(c=>keys.some(k=>c.text.includes(k))).length})).filter(x=>x.count).sort((a,b)=>b.count-a.count).slice(0,10);
    const max=Math.max(1,...counts.map(x=>x.count));
    el('wordcloud').innerHTML=counts.length?counts.map((x,i)=>`<button type="button" data-word-query="${x.word}" data-rank="${i<3?'top':'rest'}" style="font-size:${Math.round(13+9*x.count/max)}px" title="${x.count} 条评论提到“${x.word}”">${x.word}<span class="word-count">${x.count}</span></button>`).join(''):'<span class="muted">当前分类没有足够的表达。</span>';
  }
  function renderComments() {
    const rows=visibleComments();el('checkHead').hidden=!state.selecting;
    const cols=state.selecting?'<col style="width:34px">':'';
    el('commentCols').innerHTML=cols+[26,6,17,12,8,7,9,10,5].map(p=>'<col style="width:'+p+'%'+'">').join('');
    el('commentRows').innerHTML=rows.map(c=>{const s=statusInfo(c),r=c.currentResult;return `<tr data-comment-id="${c.id}" class="${state.selected.has(c.id)?'selected':''}"><td class="check-cell" ${state.selecting?'':'hidden'}><input class="table-check" type="checkbox" data-select-id="${c.id}" value="${c.id}" aria-label="选择${escape(c.author)}的评论" ${state.selected.has(c.id)?'checked':''}></td><td><button type="button" class="voice-link" data-comment-id="${c.id}" title="${escape(c.text)}">${escape(c.text)}</button></td><td class="numeric" title="${fmt(c.likes)} 次点赞">${fmt(c.likes)}</td><td title="${escape(work(c.workId).title)}">${escape(work(c.workId).title)}</td><td title="${escape(s.label)}"><span class="state ${s.cls}">${escape(s.label)}</span></td><td>${r?.kind?`<span class="pill">${escape(r.kind)}</span>`:'<span class="muted">—</span>'}</td><td title="${escape(c.author)}">${escape(c.author)}</td><td class="date-cell">${c.likesDate.replaceAll('-','/')}</td><td class="date-cell" title="${date(c.observedAt)}">${date(c.observedAt).slice(5)}</td><td class="center"><button class="mark-button" data-mark-id="${c.id}" aria-pressed="${c.marked}" aria-label="${c.marked?'取消':'添加'}改帖标记：${escape(c.author)}">${c.marked?'已标':'标记'}</button></td></tr>`;}).join('')||`<tr><td colspan="${state.selecting?10:9}" class="empty"><strong>没有匹配的评论</strong><p>调整搜索词或筛选条件，再试一次。</p><button class="btn small" data-clear-filters>清除筛选</button></td></tr>`;
    el('commentCount').innerHTML=`当前筛选 <b>${rows.length}</b> / ${data.comments.length} 条评论`;
    el('commentContext').innerHTML=state.workId?`<span>限定作品：${escape(work(state.workId).title)}</span> <button class="text-action" id="clearWorkFilter" aria-label="取消作品筛选">移除</button>`:state.problemId?`<span>支持问题：${escape(problem(state.problemId)?.title||state.problemId)}</span> <button class="text-action" id="clearProblemFilter" aria-label="取消问题筛选">移除</button>`:'';
    {const sm=data.summary;el('commentsMeta').innerHTML=researchSegments(sm).map(([label,n])=>`${label} <b>${fmt(n)}</b>`).join(' · ')+(sm.waiting?`<span class="meta-split">${fmt(sm.waiting)} 条待作品语境</span>`:'');}
    el('commentPageMeta').textContent=`第 1 页 · 共 ${rows.length} 条`;
    el('selectAll').disabled=rows.length===0;el('selectAll').checked=rows.length>0&&rows.every(c=>state.selected.has(c.id));el('selectAll').indeterminate=rows.some(c=>state.selected.has(c.id))&&!el('selectAll').checked;
    updateSelection(rows);
  }
  function updateSelection(rows=visibleComments()) {
    const p=selectedPlan(),visible=rows.filter(c=>state.selected.has(c.id)).length;
    el('selectionBar').hidden=!p.selectedCount;el('selectedSummary').textContent=`已选 ${p.selectedCount} 条评论`;
    el('selectedScale').innerHTML=`将提交 <b>${p.researchableCount}</b> 条 · 预计调用 <b>${p.callCount}</b> 次`;
    const notes=[];if(p.excludedCount)notes.push(`${p.excludedCount} 条不会提交（${[p.waitingCount?`${p.waitingCount} 条待作品语境`:'',p.activeCount?`${p.activeCount} 条正在研究`:''].filter(Boolean).join('、')}）`);if(p.rerunCount)notes.push(`${p.rerunCount} 条已有结果，将生成新结果`);if(p.selectedCount>visible)notes.push(`${p.selectedCount-visible} 条在当前筛选之外`);
    el('selectedDetail').textContent=notes.join(' · ');el('previewButton').disabled=!p.selectedCount;
    el('selectionAnnouncement').textContent=p.selectedCount?`已选择${p.selectedCount}条，将提交${p.researchableCount}条`:(state.announceClear||'');state.announceClear='';
    document.getElementById('comments').classList.toggle('has-selection',!!p.selectedCount);
  }
  function clearFilters() { ['search','minLikes'].forEach(id=>el(id).value='');['statusFilter','tagFilter','markFilter'].forEach(id=>el(id).value='all');state.workId=null;state.problemId=null;renderComments(); }
  function renderProblems() {
    const q=el('problemSearch').value.trim().toLowerCase(),filter=el('problemStatus').value,sort=el('problemSort').value;
    const rows=data.problems.filter(p=>(filter==='all'||p.state===filter)&&(!q||(p.title+p.desc+p.id).toLowerCase().includes(q))).sort((a,b)=>sort==='recent'?b.date.localeCompare(a.date)||a.id.localeCompare(b.id):b[sort]-a[sort]);
    el('problemCount').textContent=`显示 ${rows.length} / ${data.problems.length} 个问题`;
    {const f=data.problems.filter(x=>x.state==='formal').length;el('problemsMeta').innerHTML=`正式 <b>${f}</b> · 候选 <b>${data.problems.length-f}</b><span class="meta-split">正式问题：至少 2 位不同作者提到</span>`;}
    el('problemGrid').innerHTML=rows.map(p=>{
      const filled=Math.min(8,p.authors);
      return `<article class="pa-card" data-emblem="${p.emblem}" aria-labelledby="title-${p.id}"><div class="pa-banner" aria-hidden="true"><span class="pa-corner tl"></span><span class="pa-corner tr"></span><span class="pa-corner bl"></span><span class="pa-corner br"></span><div class="pa-banner-label"><i class="pa-signal-dot"></i><span>LI / PROBLEM ARCHIVE</span></div><div class="pa-orb"></div><div class="pa-pixel-code">${paPixelSVG(p.id.slice(-2))}</div>${paParticleWakeSVG()}<div class="pa-emblem-wrap"><span class="pa-emblem"></span><span class="pa-emblem-print"></span></div></div><div class="pa-card-body"><div class="pa-meta-row"><span class="pa-archive-id">ARCHIVE / ${p.id}</span><span class="pa-state ${p.state}">${p.state==='formal'?'正式':'候选'}</span></div><div class="pa-title-block"><div class="pa-title-line"><h2 class="pa-card-title" id="title-${p.id}">${escape(p.title)}</h2></div><p class="pa-card-desc" title="${escape(p.desc)}">${escape(p.desc)}</p></div><div class="pa-metrics"><div class="pa-author-count"><b>${String(p.authors).padStart(2,'0')}</b><span>独立作者</span></div><div class="pa-support" title="每格 1 位独立作者；第 2 格后的刻线是正式门槛"><div class="pa-support-label">正式门槛 2 位</div><div class="pa-support-bars" aria-hidden="true">${Array.from({length:8},(_,i)=>`<i class="${i<filled?'filled':''}${i===1?' threshold':''}"></i>`).join('')}</div></div><div class="pa-small-metric"><b>${String(p.comments).padStart(2,'0')}</b><span>评论</span></div><div class="pa-small-metric"><b>${String(p.works).padStart(2,'0')}</b><span>作品</span></div></div><div class="pa-card-footer"><span class="pa-last-research">最近研究 ${p.date.replaceAll('.','/')}</span><button class="pa-open-record" data-problem-id="${p.id}" aria-label="打开${escape(p.title)}档案">打开档案 <span class="arrow" aria-hidden="true">↗</span></button></div></div></article>`;
    }).join('')||'<div class="pa-empty"><strong>没有找到匹配的问题</strong><p>调整搜索词或筛选条件。</p><button class="btn small" id="resetProblemFilters">清除筛选</button></div>';
  }
  function inspectorRootTrigger() { return modalMeta.get(el('inspector'))?.trigger||document.activeElement; }
  function openComment(id,trigger=document.activeElement,related=false) { if(!comment(id)){toast('未找到这条评论。');return;}showInspector('comment',id,trigger,related); }
  function openProblem(id,trigger=document.activeElement,related=false) { if(!problem(id)){toast('未找到这个问题。');return;}showInspector('problem',id,trigger,related); }
  function showInspector(type,id,trigger,related) {
    const d=el('inspector'),open=d.open;
    if(open&&related&&state.inspector)state.inspectorHistory.push({...state.inspector});else if(!open)state.inspectorHistory=[];
    state.inspector={type,id};renderInspector();
    if(!open)openModal(d,trigger);else{el('inspectorBody').scrollTop=0;el('inspectorTitle').setAttribute('tabindex','-1');el('inspectorTitle').focus({preventScroll:true});}
  }
  function footerBack() {return state.inspectorHistory.length?'<button class="btn quiet small" id="inspectorBack">返回上一项</button>':'<span class="footer-note">'+(state.inspector.type==='comment'?escape(state.inspector.id):'证据可回到原始评论')+'</span>';}
  function renderInspector() {
    if(!state.inspector)return;
    if(state.inspector.type==='comment'){
      const c=comment(state.inspector.id),w=work(c.workId),r=c.currentResult,s=statusInfo(c),running=c.latestExecution.state==='running';
      el('inspectorTitle').textContent='评论详情';
      let result=r?`<div class="result-title"><span class="state ${r.outcome==='needs_context'?'wait':'good'}">${r.outcome==='signals'?'已有有效结果':r.outcome==='needs_context'?'研究完成 · 需要语境':'研究完成 · 无信号'}</span>${r.kind?`<span class="pill">${escape(r.kind)}</span>`:''}</div><div class="research-result"><p>${escape(r.proposition)}</p>${r.problemId?`<p>问题归属　<button class="text-action" data-related-problem="${r.problemId}">${escape(problem(r.problemId)?.title||r.problemId)} ${icon('ArrowUpRight')}</button></p>`:''}</div>`:'<p class="muted" style="font-size:13px;margin:0">尚未产生有效研究结果。</p>';
      if(c.latestExecution.state==='failed')result=`<div class="notice" style="margin:0 0 13px"><strong>最近一次执行失败</strong><br>${escape(c.latestExecution.failure||'未取得新的研究结果。')}${r?'<br>以下仍显示此前的有效结果。':''}</div>`+result;
      if(running)result='<div class="notice info" style="margin:0 0 13px">正在研究这条评论。'+(r?'已有有效结果继续保留。':'完成后会更新结果。')+'</div>'+result;
      el('inspectorBody').innerHTML=`<section class="drawer-section"><h3>原始评论</h3><blockquote class="quote">${r?.quote&&c.text.includes(r.quote)?escape(c.text).replace(escape(r.quote),`<mark title="研究引用的证据原文">${escape(r.quote)}</mark>`):escape(c.text)}</blockquote>${r?.quote?'<p class="quote-note"><i></i>标出部分是研究引用的证据原文</p>':''}<div class="facts"><span>${escape(c.author)}</span><span>点赞 ${fmt(c.likes)}</span><span>观测 ${date(c.observedAt)}</span></div></section><section class="drawer-section"><h3>所属作品 · 作品语境</h3><div class="work-context"><strong>${escape(w.title)}</strong><p>${w.l1Ready?escape(w.context):'该作品的语境尚未就绪，补充后即可研究其评论。'}</p></div><button class="text-action" data-work-filter="${w.id}" style="margin-top:8px">查看该作品的评论 ${icon('ArrowRight')}</button></section><section class="drawer-section"><h3>评论研究</h3>${result}${r&&!running?'<p class="threshold-note">重新研究会生成新结果；现有结果保留到新结果完成为止。</p>':''}</section>`;
      const action=!w.l1Ready?'<button class="btn primary" id="inspectorL1">补充作品语境</button>':(r&&!running?`<button class="btn" id="inspectorResearch">重新研究</button>`:`<button class="btn primary" id="inspectorResearch" ${running?'disabled':''}>${running?'研究中':c.latestExecution.state==='failed'?'重试研究':'研究此条'}</button>`);
      el('inspectorFooter').innerHTML=footerBack()+`<div class="actions">${c.latestExecution.runId?`<button class="btn" id="inspectorRun" data-run-id="${c.latestExecution.runId}">查看研究记录</button>`:''}${action}</div>`;
    }else{
      const p=problem(state.inspector.id);el('inspectorTitle').textContent='用户问题档案';
      const evidence=p.evidenceIds.map(comment).filter(Boolean);
      el('inspectorBody').innerHTML=`<section class="drawer-section"><div style="display:flex;align-items:center;justify-content:space-between;gap:12px"><span class="pa-archive-id">ARCHIVE / ${p.id}</span><span class="pa-state ${p.state}">${p.state==='formal'?'正式问题':'候选问题'}</span></div><h3 class="detail-title">${escape(p.title)}</h3><p class="detail-desc">${escape(p.desc)}</p><div class="detail-metrics"><div><b>${p.authors}</b><span>独立作者</span></div><div><b>${p.comments}</b><span>评论证据</span></div><div><b>${p.works}</b><span>相关作品</span></div></div><p class="threshold-note">${p.state==='candidate'?`目前 ${p.authors} 位独立作者支持；再有 ${Math.max(1,2-p.authors)} 位不同作者提到，就成为正式问题。`:`已有 ${p.authors} 位独立作者支持，超过正式门槛（2 位）。`}</p></section><section class="drawer-section"><h3>问题定义</h3><dl class="definition"><dt>谁</dt><dd>${escape(p.actor)}</dd><dt>目标</dt><dd>${escape(p.goal)}</dd><dt>阻碍</dt><dd>${escape(p.barrier)}</dd><dt>场景</dt><dd>${escape(p.context)}</dd></dl></section><section class="drawer-section"><h3>支持这一问题的原声 · ${evidence.length} 条</h3>${evidence.map(c=>`<article class="evidence"><p>${escape(c.currentResult.proposition)}</p><blockquote>${escape(c.currentResult.quote)}</blockquote><div class="evidence-source"><span>${escape(c.author)} · ${escape(work(c.workId).title)}</span><button class="text-action" data-related-comment="${c.id}" aria-label="查看${escape(c.author)}的完整评论">原声 ${icon('ArrowUpRight')}</button></div></article>`).join('')}</section><section class="drawer-section"><h3>归并历史</h3><p class="muted" style="font-size:12px;margin:0">暂无问题归并记录。</p></section>`;
      el('inspectorFooter').innerHTML=footerBack()+`<div class="actions"><button class="btn" id="inspectorDone">关闭</button>${p.comments?`<button class="btn primary" id="inspectorProblemComments">查看全部支持评论 ${icon('ArrowRight')}</button>`:''}</div>`;
    }
  }
  function backInspector() {const prev=state.inspectorHistory.pop();if(!prev)return;state.inspector=prev;renderInspector();el('inspectorBody').scrollTop=0;el('inspectorTitle').focus({preventScroll:true});}
  function openPreview(ids=state.selected,trigger=document.activeElement,returnTo=null) {
    state.previewIds=new Set(ids);state.previewReturn=returnTo;if(!state.previewIds.size){toast('请先选择评论。');return;}renderPreview();openModal(el('previewDialog'),trigger);
  }
  function renderPreview() {
    const p=data.derivePlan(state.previewIds);
    const submitGroups=p.groups.filter(g=>g.eligibleIds.length);
    const excluded=[...p.waitingIds.map(id=>({id,why:'作品语境未就绪',act:`<button class="text-action" data-complete-one="${id}">补充作品语境</button>`})),...p.activeIds.map(id=>({id,why:'正在研究，不会重复提交',act:`<button class="text-action" data-active-run="${comment(id).latestExecution.runId}">查看进行中</button>`}))];
    el('previewBody').innerHTML=`<div class="preview-lead"><strong>将提交 <b>${fmt(p.researchableCount)}</b> 条评论 · 预计调用 <b>${fmt(p.callCount)}</b> 次</strong><span>已选 ${fmt(p.selectedCount)} 条${p.excludedCount?`，其中 ${fmt(p.excludedCount)} 条不会提交`:''}</span></div>
      <div class="preview-summary"><div><b>${fmt(p.researchableCount)}</b><span>将提交评论</span></div><div title="每个研究单元调用 1 次模型；同一作品的评论最多 20 条合成一个单元"><b>${fmt(p.callCount)}</b><span>预计调用</span></div><div><b>${fmt(submitGroups.length)}</b><span>涉及作品</span></div><div><b>${fmt(p.excludedCount)}</b><span>不会提交</span></div></div>
      ${p.rerunCount?`<div class="notice info">其中 ${fmt(p.rerunCount)} 条已有研究结果：本次会生成新结果，现有结果保留到新结果完成为止。</div>`:''}
      <h3 class="preview-h">将提交 · 按所属作品分组</h3>
      ${submitGroups.map(g=>`<div class="plan-group"><div><strong>${escape(work(g.workId).title)}</strong><small>${g.eligibleIds.length} 条评论 · ${g.unitsCount} 个研究单元${(g.rerunIds||[]).length?` · ${g.rerunIds.length} 条已有结果`:''}</small></div><span class="state good">可进入研究</span></div>`).join('')||'<p class="muted preview-none">没有可提交的评论。</p>'}
      ${excluded.length?`<details class="preview-excluded"${p.unitCount?'':' open'}><summary>不会提交 ${fmt(excluded.length)} 条 <span>查看原因与处理办法</span></summary>${excluded.map(x=>{const c=comment(x.id);return `<div class="excluded-row"><div><p>${escape(c.text)}</p><small>${escape(work(c.workId).title)} · ${x.why}</small></div>${x.act}</div>`;}).join('')}</details>`:''}`;
    el('previewFootnote').textContent=p.unitCount?`提交后可在“研究记录”查看进度，关闭窗口不影响任务`:'当前没有可提交的研究单元';
    el('startResearch').disabled=!p.unitCount||state.submitting;el('startResearch').textContent=state.submitting?'正在提交…':p.unitCount?`提交 ${p.researchableCount} 条研究`:'开始研究';
  }
  function closePreview() {
    const back=state.previewReturn;state.previewReturn=null;
    closeModal(el('previewDialog'),{restore:!back});
    if(back)openComment(back.id,back.trigger);
  }
  function completeL1(ids) {
    const works=new Set([...ids].map(comment).filter(Boolean).map(c=>c.workId));let count=0;
    works.forEach(id=>{const w=work(id);if(w.l1Ready)return;w.l1Ready=true;w.context=id==='W-07'?'作品讨论家长陪伴作业中的情绪压力，以及在冲突升级前暂停、恢复沟通的方法。重点是维持关系与可持续的家庭支持。':'作品分享减少日常遗漏的准备方法，包括固定物品位置、提前整理和使用简单清单，并强调做法应易于持续。';count++;});
    refreshAll();if(el('previewDialog').open)renderPreview();if(el('inspector').open)renderInspector();toast(count?`已补充 ${count} 篇作品的演示语境。`:'作品语境已经就绪。');
  }
  function createRun(units,sourceId=null) {
    const stamp=new Date(),id='R-'+date(stamp).slice(5,10).replace('/','')+'-'+String(runSequence++).padStart(2,'0');
    const run={id,createdAt:stamp.toISOString(),state:'running',retryOf:sourceId,units:units.map((u,i)=>({id:id+'-U'+String(i+1).padStart(2,'0'),workId:u.workId,commentIds:[...u.commentIds],state:i===0?'running':'queued',signalCount:0,contextCount:0,noSignalCount:0,error:null})),usage:{calls:1,inputTokens:820+units[0].commentIds.length*72,outputTokens:0}};
    run.units[0].callStarted=true;data.runs.unshift(run);
    units.flatMap(u=>u.commentIds).forEach(id=>{const c=comment(id);c.latestExecution={state:'running',runId:run.id};});
    return run;
  }
  function submitPreview() {
    if(state.submitting)return;const p=data.derivePlan(state.previewIds);if(!p.unitCount){renderPreview();return;}
    state.submitting=true;el('startResearch').disabled=true;
    const run=createRun(p.units);p.units.flatMap(u=>u.commentIds).forEach(id=>state.selected.delete(id));state.previewReturn=null;
    closeModal(el('previewDialog'),{restore:false});state.submitting=false;refreshAll();ResearchRecords.open({runId:run.id,trigger:el('recordsEntry')});startSimulation();toast(`已提交 ${p.researchableCount} 条评论，共 ${p.unitCount} 个研究单元。`);
  }
  function retryRun(id) {
    const source=data.runs.find(r=>r.id===id);if(!source)return false;
    const units=source.units.filter(u=>u.state==='failed').map(u=>({workId:u.workId,commentIds:u.commentIds.filter(id=>comment(id)?.latestExecution.state!=='running')})).filter(u=>u.commentIds.length&&work(u.workId).l1Ready);
    if(!units.length){toast('失败评论已在处理中，无需重复提交。');return false;}
    const run=createRun(units,id);refreshAll();startSimulation();return run.id;
  }
  function ensureGeneratedProblem(id) {
    if(problem(id))return;
    const defs={ 'P-032':{title:'陪伴学习中的情绪压力',desc:'家长在长期陪伴作业中积累疲惫，沟通容易转为冲突，需要可持续的支持方式。',actor:'陪伴孩子学习的家长',goal:'在维持亲子关系的同时提供学习支持',barrier:'疲惫积累；反复催促；冲突升级',context:'晚间陪伴作业与家庭沟通',code:'2FA'},'P-033':{title:'日常物品容易遗漏',desc:'日常准备缺少稳定线索，容易反复寻找或遗漏物品。',actor:'需要管理日常准备的家庭',goal:'顺利完成每天的出门准备',barrier:'物品位置分散；准备步骤不固定',context:'早晨出门与前一晚准备',code:'3BC'} };
    if(!defs[id])return;data.problems.push({id,...defs[id],date:date(new Date()).slice(0,10).replaceAll('/','.'),scan:String(data.problems.length+1).padStart(2,'0')+' / NEW',orbX:'34%',codeX:'42%',orbSize:72,orbY:-18,authors:0,comments:0,works:0,state:'candidate',evidenceIds:[]});
  }
  function syntheticResult(c) {
    if(c.currentResult)return c.currentResult;
    const plans={
      'C-017':['P-032','情绪体验','持续陪伴作业积累了疲惫，短暂暂停有助于减少双方冲突。'],
      'C-018':['P-032','情绪体验','家长希望先缓和亲子关系，再讨论作业效率。'],
      'C-019':['P-033','办法与经历','前一晚把物品放在固定位置，减少了次日反复寻找。'],
      'C-021':['P-008','困难场景','完整任务量带来启动压力，减少眼前任务范围可能有助于开始。'],
      'C-022':['P-014','困难场景','关闭提醒后，环境声音仍会中断正在进行的学习。'],
      'C-023':['P-021','困难场景','只有对错标记时，孩子难以区分理解错误与计算错误。'],
      'C-024':['P-008','办法与经历','可见的步骤清单帮助孩子启动任务并看到自己的进展。']
    };
    const p=plans[c.id];if(!p)return {outcome:'no_signal',kind:null,proposition:'评论表达了对方法的认可，但没有提供足以单独归纳的具体场景。',quote:'',problemId:null};
    ensureGeneratedProblem(p[0]);return {outcome:'signals',problemId:p[0],kind:p[1],proposition:p[2],quote:c.text};
  }
  function deriveRunState(run) {const active=run.units.some(u=>u.state==='running'||u.state==='queued'),failed=run.units.filter(u=>u.state==='failed').length,complete=run.units.filter(u=>u.state==='completed').length;run.state=active?'running':failed?(complete?'partial':'failed'):'completed';}
  function advanceRuns() {
    const active=data.runs.filter(r=>r.units.some(u=>u.state==='running'||u.state==='queued'));
    if(!active.length)return false;
    active.forEach(run=>{
      const unit=run.units.find(u=>u.state==='running')||run.units.find(u=>u.state==='queued');
      if(!unit.callStarted){unit.callStarted=true;run.usage.calls=Math.max(run.usage.calls,run.units.filter(u=>u.callStarted).length);}
      unit.state='completed';unit.finishedAt=new Date().toISOString();unit.error=null;
      unit.commentIds.forEach(id=>{const c=comment(id);c.currentResult=syntheticResult(c);c.latestExecution={state:'succeeded',runId:run.id};if(c.currentResult.problemId){const p=problem(c.currentResult.problemId);if(p)p.date=date(new Date()).slice(0,10).replaceAll('/','.');}});
      const outcomes=unit.commentIds.map(id=>comment(id).currentResult.outcome);unit.signalCount=outcomes.filter(o=>o==='signals').length;unit.contextCount=outcomes.filter(o=>o==='needs_context').length;unit.noSignalCount=outcomes.filter(o=>o==='no_signal').length;
      run.usage.outputTokens+=180+unit.commentIds.length*94;
      const next=run.units.find(u=>u.state==='queued');if(next){next.state='running';next.callStarted=true;run.usage.calls++;run.usage.inputTokens+=780+next.commentIds.length*72;}
      deriveRunState(run);
    });
    state.updatedAt=new Date().toISOString();state.currentEnd=date(state.updatedAt).slice(0,10).replaceAll('/','-');refreshAll();return true;
  }
  function startSimulation() {
    if(state.simulation)return;
    state.simulation=setInterval(()=>{
      if(!advanceRuns()){clearInterval(state.simulation);state.simulation=null;return;}
      if(!data.runs.some(r=>r.state==='running')){clearInterval(state.simulation);state.simulation=null;toast('本轮研究已结束，结果已更新。');}
    },4500);
  }
  function updateRecordBadge() {
    const active=data.runs.filter(r=>r.units.some(u=>u.state==='running'||u.state==='queued')).length;
    const failed=data.runs.filter(r=>r.units.some(u=>u.state==='failed')).length;
    const node=el('recordBadge');node.hidden=!active&&!failed;node.textContent=active?`${active} 项进行中`:failed?`${failed} 项有失败`:'';
    el('recordsEntry').setAttribute('aria-label','研究记录'+(active?`，${active}项进行中`:'')+(failed?`，${failed}项有失败`:''));
  }
  function refreshAll() {
    const oldFocus=document.activeElement,focusRef=focusDescriptor(oldFocus),inspectorScroll=el('inspectorBody').scrollTop;
    recomputeProblems();renderOverview();renderComments();renderProblems();updateRecordBadge();
    if(el('recordsDialog').open)ResearchRecords.render();if(el('previewDialog').open)renderPreview();if(el('inspector').open){renderInspector();el('inspectorBody').scrollTop=inspectorScroll;}
    if(oldFocus&&!oldFocus.isConnected){const restored=resolveFocus(focusRef);if(restored)restored.focus({preventScroll:true});}
  }
  function init() {
    fillIcons();initializeModals();ResearchRecords.init();
    document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>switchView(b.dataset.view)));
    el('recordsEntry').addEventListener('click',()=>{ResearchRecords.open({trigger:el('recordsEntry')});startSimulation();});
    el('candidateShortcut').addEventListener('click',()=>{el('problemStatus').value='candidate';el('problemSearch').value='';switchView('problems',{top:true});});
    el('problemSearchButton').addEventListener('click',()=>{renderProblems();el('problemSearch').focus();});
    document.querySelectorAll('[data-range]').forEach(b=>b.addEventListener('click',()=>{state.days=b.dataset.range==='fit'?'fit':Number(b.dataset.range);document.querySelectorAll('[data-range]').forEach(n=>{const on=n===b;n.classList.toggle('active',on);n.setAttribute('aria-pressed',String(on));});renderTrend();}));
    document.querySelectorAll('[data-chart-mode]').forEach(b=>b.addEventListener('click',()=>{state.chartMode=b.dataset.chartMode;document.querySelectorAll('[data-chart-mode]').forEach(n=>{const on=n===b;n.classList.toggle('active',on);n.setAttribute('aria-pressed',String(on));});renderTrend();}));
    document.querySelectorAll('[data-word]').forEach(b=>b.addEventListener('click',()=>{state.word=b.dataset.word;document.querySelectorAll('[data-word]').forEach(n=>{const on=n===b;n.classList.toggle('active',on);n.setAttribute('aria-pressed',String(on));});renderWords();}));
    ['search','minLikes'].forEach(id=>el(id).addEventListener('input',renderComments));['searchScope','statusFilter','tagFilter','commentSort','markFilter'].forEach(id=>el(id).addEventListener('change',renderComments));
    el('searchButton').addEventListener('click',()=>{renderComments();el('search').focus();});
    el('advancedButton').addEventListener('click',()=>{el('advancedFilters').hidden=!el('advancedFilters').hidden;el('advancedButton').setAttribute('aria-expanded',String(!el('advancedFilters').hidden));});
    el('clearFilters').addEventListener('click',clearFilters);
    el('selectMode').addEventListener('click',()=>{state.selecting=!state.selecting;if(!state.selecting&&state.selected.size){state.announceClear=`已退出选择，清空了 ${state.selected.size} 条已选评论`;toast(state.announceClear);state.selected.clear();}el('selectMode').innerHTML=icon('ListChecks')+(state.selecting?'退出选择':'选择评论');el('selectMode').setAttribute('aria-pressed',String(state.selecting));renderComments();});
    el('selectAll').addEventListener('change',()=>{visibleComments().forEach(c=>{if(el('selectAll').checked)state.selected.add(c.id);else state.selected.delete(c.id);});renderComments();});
    el('commentRows').addEventListener('change',event=>{const input=event.target.closest('[data-select-id]');if(!input)return;if(input.checked)state.selected.add(input.dataset.selectId);else state.selected.delete(input.dataset.selectId);input.closest('tr').classList.toggle('selected',input.checked);const rows=visibleComments();el('selectAll').checked=rows.length>0&&rows.every(c=>state.selected.has(c.id));el('selectAll').indeterminate=rows.some(c=>state.selected.has(c.id))&&!el('selectAll').checked;updateSelection(rows);});
    el('clearSelection').addEventListener('click',()=>{state.selected.clear();renderComments();});
    el('previewButton').addEventListener('click',()=>openPreview());
    el('previewClose').addEventListener('click',closePreview);el('previewBack').addEventListener('click',closePreview);el('startResearch').addEventListener('click',submitPreview);
    el('inspectorClose').addEventListener('click',()=>closeModal(el('inspector')));
    ['problemSearch','problemStatus','problemSort'].forEach(id=>el(id).addEventListener(id==='problemSearch'?'input':'change',renderProblems));
    document.addEventListener('click',event=>{
      const b=event.target.closest('button');if(!b)return;
      if(b.dataset.commentId)openComment(b.dataset.commentId,b);
      else if(b.dataset.problemId)openProblem(b.dataset.problemId,b);
      else if(b.dataset.relatedComment)openComment(b.dataset.relatedComment,b,true);
      else if(b.dataset.relatedProblem)openProblem(b.dataset.relatedProblem,b,true);
      else if(b.dataset.markId){const c=comment(b.dataset.markId);c.marked=!c.marked;renderComments();document.querySelector(`[data-mark-id="${c.id}"]`)?.focus({preventScroll:true});toast(c.marked?'已添加改帖标记。':'已取消改帖标记。');}
      else if(b.dataset.wordQuery){clearFilters();el('search').value=b.dataset.wordQuery;state.phrase=b.dataset.wordQuery;el('searchScope').value='comment';switchView('comments',{top:true});el('search').focus({preventScroll:true});}
      else if(b.hasAttribute('data-clear-filters'))clearFilters();
      else if(b.dataset.workFilter){const trigger=inspectorRootTrigger();closeModal(el('inspector'),{restore:false});clearFilters();state.workId=b.dataset.workFilter;switchView('comments',{top:true});el('search').focus({preventScroll:true});}
      else if(b.id==='clearWorkFilter'){state.workId=null;renderComments();}
      else if(b.id==='clearProblemFilter'){state.problemId=null;renderComments();}
      else if(b.id==='inspectorProblemComments'){const id=state.inspector.id;closeModal(el('inspector'),{restore:false});clearFilters();state.problemId=id;switchView('comments',{top:true});}
      else if(b.id==='resetProblemFilters'){el('problemSearch').value='';el('problemStatus').value='all';renderProblems();el('problemSearch').focus();}
      else if(b.id==='inspectorBack')backInspector();
      else if(b.id==='inspectorDone')closeModal(el('inspector'));
      else if(b.id==='inspectorResearch'){const c=comment(state.inspector.id),trigger=inspectorRootTrigger();closeModal(el('inspector'),{restore:false});openPreview([c.id],trigger,{id:c.id,trigger});}
      else if(b.id==='inspectorL1')completeL1([state.inspector.id]);
      else if(b.id==='completeL1')completeL1(state.previewIds);
      else if(b.dataset.completeOne)completeL1([b.dataset.completeOne]);
      else if(b.dataset.activeRun){closeModal(el('previewDialog'),{restore:false});ResearchRecords.open({runId:b.dataset.activeRun,trigger:el('recordsEntry')});startSimulation();}
      else if(b.id==='inspectorRun'){const trigger=inspectorRootTrigger();closeModal(el('inspector'),{restore:false});ResearchRecords.open({runId:b.dataset.runId,trigger});startSimulation();}
    });
    refreshAll();
  }
  return {data,state,escape,fmt,date,icon,toast,openModal,closeModal,retryRun,advanceRuns,updateRecordBadge,init,renderComments,renderProblems,renderOverview,openComment,openProblem,openPreview,refreshAll};
}());

(function () {
  'use strict';
  const expanded = new Set();
  let initialized = false;
  const el = id => document.getElementById(id);
  const escape = value => App.escape(String(value == null ? '' : value));
  const fmt = value => App.fmt(Number(value) || 0);
  const statusLabels = { running: '进行中', completed: '已完成', partial: '部分失败', failed: '失败', queued: '等待执行' };
  function unitState(unit) { return unit.state || 'queued'; }
  function summarize(run) {
    const units = run.units || [];
    const completed = units.filter(u => unitState(u) === 'completed').length;
    const failed = units.filter(u => unitState(u) === 'failed').length;
    const pending = units.length - completed - failed;
    const state = pending ? 'running' : failed ? (completed ? 'partial' : 'failed') : 'completed';
    return {
      units, state, completed, failed, pending,
      workCount: new Set(units.map(u => u.workId)).size,
      commentCount: units.reduce((n, u) => n + (u.commentIds || []).length, 0),
      signals: units.reduce((n, u) => n + (unitState(u) === 'completed' ? Number(u.signalCount) || 0 : 0), 0),
      context: units.reduce((n, u) => n + (unitState(u) === 'completed' ? Number(u.contextCount) || 0 : 0), 0),
      noSignal: units.reduce((n, u) => n + (unitState(u) === 'completed' ? Number(u.noSignalCount) || 0 : 0), 0)
    };
  }
  function workTitle(id) {
    const work = App.data.works.find(w => w.id === id);
    return work ? work.title : '未命名作品';
  }
  function detailId(id) { return 'record-details-' + String(id).replace(/[^a-zA-Z0-9_-]/g, '_'); }
  function statusBadge(state) { return '<span class="records-status is-' + escape(state) + '">' + escape(statusLabels[state] || state) + '</span>'; }
  function unitDetails(run, summary) {
    const usage = run.usage || {};
    return '<tr class="records-details-row"><td colspan="6"><section class="records-details" id="' + detailId(run.id) + '" aria-label="' + escape(run.id) + ' 的研究单元">' +
      '<div class="records-details-heading"><h3>研究单元</h3><span>' + fmt(summary.units.length) + ' 个单元 · 按所属作品组织</span></div>' +
      '<table class="records-units"><colgroup><col style="width:32%"><col style="width:9%"><col style="width:13%"><col style="width:46%"></colgroup><thead><tr><th scope="col">所属作品 / 单元</th><th scope="col" class="records-num">评论数</th><th scope="col">状态</th><th scope="col">结果 / 原因</th></tr></thead><tbody>' +
      summary.units.map(unit => {
        const state = unitState(unit);
        const message = state === 'completed'
          ? '<span class="records-unit-results">有信号 ' + fmt(unit.signalCount) + ' · 需要语境 ' + fmt(unit.contextCount) + ' · 无信号 ' + fmt(unit.noSignalCount) + '</span>'
          : state === 'failed'
            ? '<span class="records-unit-error">' + escape(unit.error || '该单元未完成，可重试失败项。') + '</span>'
            : '<span class="records-unit-muted">' + (state === 'running' ? '正在研究该作品的评论，结果生成后会更新。' : '等待执行，尚未生成本次研究结果。') + '</span>';
        return '<tr><td><span class="records-unit-work">' + escape(workTitle(unit.workId)) + '</span><span class="records-unit-id">' + escape(unit.id) + '</span></td><td class="records-num">' + fmt((unit.commentIds || []).length) + '</td><td>' + statusBadge(state) + '</td><td>' + message + '</td></tr>';
      }).join('') + '</tbody></table><div class="records-usage"><span>模型调用 <b>' + fmt(usage.calls) + '</b> 次</span><span>输入 <b>' + fmt(usage.inputTokens) + '</b> Token</span><span>输出 <b>' + fmt(usage.outputTokens) + '</b> Token</span>' + (summary.pending ? '<span>执行中的用量将在结束后更新</span>' : '') + '</div></section></td></tr>';
  }
  function row(run) {
    const s = summarize(run), open = expanded.has(run.id), total = s.units.length || 1;
    const progressLabel = s.pending ? s.pending + ' 待完成' : s.failed ? s.failed + ' 失败' : '全部完成';
    const progressAria = '共 ' + s.units.length + ' 个单元，已完成 ' + s.completed + ' 个，失败 ' + s.failed + ' 个，待完成 ' + s.pending + ' 个';
    const results = s.completed ? '<div class="records-results"><div><b>' + fmt(s.signals) + '</b><span>有信号</span></div><div><b>' + fmt(s.context) + '</b><span>需要语境</span></div><div><b>' + fmt(s.noSignal) + '</b><span>无信号</span></div></div>' : '<span class="records-no-result">' + (s.failed && !s.pending ? '本次未产生结果' : '等待研究结果') + '</span>';
    return '<tr class="records-row' + (open ? ' is-expanded' : '') + '" data-record-row="' + escape(run.id) + '"><td><span class="records-batch">' + escape(run.id) + '</span><time class="records-time" datetime="' + escape(run.createdAt) + '">' + escape(App.date(run.createdAt)) + '</time></td><td>' + statusBadge(s.state) + '</td><td><div class="records-size-main"><b>' + fmt(s.commentCount) + '</b><span>条评论</span></div><span class="records-subline">' + fmt(s.workCount) + ' 篇作品 · ' + fmt(s.units.length) + ' 个单元</span></td><td><div class="records-progress-label"><b>' + fmt(s.completed) + ' / ' + fmt(s.units.length) + ' 完成</b><span>' + progressLabel + '</span></div><div class="records-progress" role="img" aria-label="' + progressAria + '"><i class="complete" style="width:' + (s.completed / total * 100) + '%"></i><i class="failed" style="width:' + (s.failed / total * 100) + '%"></i></div><span class="records-progress-note">' + (s.pending ? '关闭窗口不影响任务' : s.failed ? '仅重试失败的单元' : '结果已写入评论') + '</span></td><td>' + results + '</td><td><div class="records-row-actions"><button type="button" class="btn small records-expand" data-record-action="toggle" data-run-id="' + escape(run.id) + '" aria-label="' + (open ? '收起' : '展开') + '批次 ' + escape(run.id) + '" aria-expanded="' + open + '" aria-controls="' + detailId(run.id) + '">' + (open ? '收起' : '展开') + '<span class="records-disclosure" aria-hidden="true">›</span></button>' + (s.failed && !s.pending ? '<button type="button" class="btn small records-retry" data-record-action="retry" data-run-id="' + escape(run.id) + '" aria-label="重试批次 ' + escape(run.id) + ' 中失败的单元">重试失败</button>' : '') + '</div></td></tr>' + (open ? unitDetails(run, s) : '<tr class="records-details-row" hidden><td colspan="6"><section id="' + detailId(run.id) + '"></section></td></tr>');
  }
  function render() {
    if (!el('recordsRows')) return;
    const focusedButton = document.activeElement && document.activeElement.closest('button[data-record-action][data-run-id]');
    const focusSnapshot = focusedButton && el('recordsRows').contains(focusedButton)
      ? { runId: focusedButton.dataset.runId, action: focusedButton.dataset.recordAction }
      : null;
    const scrollTop = el('recordsScroll').scrollTop;
    const all = App.data.runs || [];
    const query = el('recordsSearch').value.trim().toLocaleLowerCase();
    const filter = el('recordsState').value;
    const sort = el('recordsSort').value;
    const rows = all.filter(run => {
      const summary = summarize(run);
      const matchesState = filter === 'all' || (filter === 'errors' ? summary.failed > 0 : summary.state === filter);
      const text = [run.id, ...(run.units || []).map(u => workTitle(u.workId))].join(' ').toLocaleLowerCase();
      return matchesState && (!query || text.includes(query));
    }).sort((a, b) => (sort === 'oldest' ? 1 : -1) * (new Date(a.createdAt) - new Date(b.createdAt)));
    el('recordsRows').innerHTML = rows.length ? rows.map(row).join('') : '<tr class="records-empty-row"><td colspan="6"><strong>' + (all.length ? '没有匹配的研究记录' : '还没有研究记录') + '</strong><p>' + (all.length ? '试试其他批次编号、作品标题或执行状态。' : '从用户评论中选择评论并发起研究后，记录会出现在这里。') + '</p>' + (all.length ? '<button type="button" class="btn small" data-record-action="reset">清除筛选</button>' : '') + '</td></tr>';
    const active = all.filter(r => summarize(r).pending > 0).length;
    const errors = all.filter(r => summarize(r).failed > 0).length;
    el('recordsActivity').innerHTML = active || errors ? (active ? '<strong>' + fmt(active) + '</strong> 项进行中' : '') + (active && errors ? ' · ' : '') + (errors ? '<strong>' + fmt(errors) + '</strong> 项有失败' : '') : all.length ? '所有批次已结束' : '暂无研究批次';
    el('recordsCount').textContent = '显示 ' + rows.length + ' / ' + all.length + ' 个批次';
    if (focusSnapshot) {
      const buttons = Array.from(el('recordsRows').querySelectorAll('button[data-record-action][data-run-id]'));
      const replacement = buttons.find(button => button.dataset.runId === focusSnapshot.runId && button.dataset.recordAction === focusSnapshot.action)
        || buttons.find(button => button.dataset.runId === focusSnapshot.runId && button.dataset.recordAction === 'toggle')
        || el('recordsState');
      replacement.focus({ preventScroll: true });
    }
    el('recordsScroll').scrollTop = scrollTop;
  }
  function init() {
    if (initialized) return;
    initialized = true;
    el('recordsClose').addEventListener('click', () => App.closeModal(el('recordsDialog')));
    el('recordsSearch').addEventListener('input', render);
    el('recordsState').addEventListener('change', render);
    el('recordsSort').addEventListener('change', render);
    el('recordsRows').addEventListener('click', event => {
      const button = event.target.closest('button[data-record-action]');
      if (!button) return;
      const action = button.dataset.recordAction, id = button.dataset.runId;
      let focusId = id;
      if (action === 'reset') { el('recordsSearch').value = ''; el('recordsState').value = 'all'; render(); el('recordsSearch').focus(); return; }
      if (action === 'retry') {
        const retry = App.retryRun(id);
        if (retry === false) { render(); return; }
        focusId = typeof retry === 'string' ? retry : retry && retry.id ? retry.id : id;
        expanded.add(focusId);
        el('recordsSearch').value = ''; el('recordsState').value = 'all';
        render(); App.updateRecordBadge(); App.toast('已提交失败单元的重试，成功结果保留。');
      }
      else if (action === 'toggle') { if (expanded.has(id)) expanded.delete(id); else expanded.add(id); render(); }
      const replacement = Array.from(el('recordsRows').querySelectorAll('button[data-record-action="toggle"]')).find(b => b.dataset.runId === focusId);
      if (replacement) { replacement.focus({ preventScroll: true }); if (action === 'retry') replacement.scrollIntoView({ block: 'nearest' }); }
    });
    el('recordsRefresh').addEventListener('click', () => {
      const hadActive = (App.data.runs || []).some(r => summarize(r).pending > 0);
      App.advanceRuns(); render(); App.updateRecordBadge();
      const time = new Intl.DateTimeFormat('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Taipei' }).format(new Date());
      el('recordsUpdated').textContent = '刚刚更新 · ' + time;
      App.toast(hadActive ? '研究进度已更新。' : '记录已是最新状态。');
    });
  }
  function open(options = {}) {
    init();
    const { runId, trigger } = options;
    if (runId) { el('recordsSearch').value = ''; el('recordsState').value = 'all'; expanded.add(runId); }
    render();
    App.openModal(el('recordsDialog'), trigger || document.activeElement);
    if (runId) {
      const rowElement = Array.from(el('recordsRows').querySelectorAll('[data-record-row]')).find(node => node.dataset.recordRow === runId);
      if (rowElement) rowElement.scrollIntoView({ block: 'nearest' });
    }
  }
  window.ResearchRecords = { init, open, render };
}());

App.init();
</script>
