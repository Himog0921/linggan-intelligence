// 博主蒸馏记录：lgboom-author-dossier 技能产出的档案与创作 skill 入库后落在这里。
// 聚合单位是博主（platform + authorPlatformId），同一博主多次蒸馏为多条版本。
model Dossier {
  id               String   @id @default(cuid())
  workspaceId      String // 归属工作区
  createdById      String // 蒸馏人（User.id），用于「我的蒸馏」筛选
  authorId         String? // 可选关联 Author 实体（存在时）
  platform         String // xhs / douyin
  authorPlatformId String // 平台稳定 ID（= dossier.json author.userId），聚合键
  authorNickname   String // 展示用昵称
  distilledAt      DateTime // 这一次蒸馏的时间（= dossier.json generatedAt），版本标识
  archiveId        String?
  dataRevision     Int?
  evidenceRevision String?
  worksCount       Int      @default(0) // 基线：蒸馏当时的作品数
  countsJson       String? // dossier.json counts 全量（JSON）
  readinessJson    String? // 数据覆盖质量（dossier.json readiness，如正文/评论覆盖率）
  limitationsJson  String? // 局限说明（dossier.json limitations）
  reportBlobUrl    String? // 博主档案 HTML 的 Blob 公网地址
  reportBlobKey    String? // 报告 Blob storageKey
  skillBlobUrl     String? // SKILL.md 的 Blob 公网地址（下载用）
  skillBlobKey     String? // skill Blob storageKey
  skillMarkdown    String? // SKILL.md 全文（内联，供网页直接展示与复制）
  status           String   @default("ready") // ready | failed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  archive AuthorArchive? @relation("AuthorArchiveDossiers", fields: [archiveId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, platform, authorPlatformId, distilledAt]) // workspace 内同博主同次蒸馏不重复入库
  @@index([workspaceId])
  @@index([workspaceId, platform, authorPlatformId])
  @@index([workspaceId, archiveId, dataRevision])
  @@index([workspaceId, evidenceRevision])
  @@index([createdById])
  @@index([platform, authorPlatformId])
}

