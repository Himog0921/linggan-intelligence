// 媒体账本是唯一媒体事实来源；历史归档与兼容表已物理退役。
// 目前不能表达 partial / expression unique indexes。
model MediaBlob {
  id             String    @id @default(cuid())
  workspaceId    String
  sha256         String
  byteSize       Int
  mimeType       String
  width          Int?
  height         Int?
  durationMs     Int?
  integrityState String    @default("pending")
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  replicas         MediaReplica[]
  materializations MediaMaterialization[]

  @@unique([workspaceId, id], map: "MediaBlob_workspaceId_id_key")
  @@index([workspaceId, integrityState, createdAt])
}

model MediaReplica {
  id             String    @id @default(cuid())
  workspaceId    String
  blobId         String
  provider       String
  storageKey     String
  // 正式交付地址或稳定句柄。云副本没有它时只能作为物理事实，不能交付给页面、AI 或发布。
  deliveryHandle String?
  replicaState   String    @default("pending")
  verifiedAt     DateTime?
  lastCheckedAt  DateTime?
  etag           String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  blob MediaBlob @relation(fields: [workspaceId, blobId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, replicaState, lastCheckedAt])
  @@index([blobId])
}

