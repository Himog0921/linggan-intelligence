  lastCheckedAt              DateTime?
  cooldownUntil              DateTime?
  // V1.1 风控字段（手册第 4.15 节）：服务端成为账号风控事实源，插件只上报风险信号。
  riskControlUntil           DateTime?
  riskControlCode            String?
  riskControlObservedAt      DateTime?
  riskControlEvidence        Json?
  riskControlSourceStationId String?
  // V1.1 失败评分（手册第 4.15 节）：失败归因 + 评分，作为 AccountHealthProjection 输入。
  recentFailureScore         Int       @default(0)
  lastFailureCode            String?
  lastFailureScope           String?
  lastFailureAt              DateTime?
  dailyTaskCount             Int       @default(0)
  dailyOpenedCount           Int       @default(0)
  dailySuccessCount          Int       @default(0)
  dailyFailedCount           Int       @default(0)
  dailyWindowDate            String?
  rawProfile                 String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  station ExecutionStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, platform])
  @@index([workspaceId])
  @@index([platform])
  @@index([platform, platformAccountId])
  @@index([purpose])
  @@index([healthStatus])
  // V1.1 风控索引（手册第 4.15 节）
  @@index([workspaceId, platform, riskControlUntil])
}

