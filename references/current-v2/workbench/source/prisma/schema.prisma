generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ExecutionTaskStatus {
  pending
  dispatched
  running
  paused
  stopping
  stopped
  completed
  failed
}

enum ExecutionTaskPhase {
  assigned
  preparing
  running
  raw_submitting
  completed
}

enum ExecutionTaskWritebackStatus {
  pending
  success
  skipped
  retryable
  failed
}

enum ExecutionTaskAttemptResult {
  success
  failed
  released
  expired
  page_mismatch
  stopped
  // V1.1：raw-snapshot-ingest 处理旧 leaseEpoch 时标记，结果有效但已过期不再触发写回。
  stale_result
}

enum ExecutionTaskFailureScope {
  task
  station
  account
  platform
  unknown
}

enum ExecutionQueueEntryStatus {
  queued
  reserved
  in_progress
  // V1.1（手册第 4.5 节）：采集流程生命周期扩展。
  // raw_committed: RawSnapshot 已落地，等待归一化；writeback_pending: 已派发 WritebackDelivery。
  raw_committed
  writeback_pending
  succeeded
  failed
  cancelled
}

enum TaskDemandStatus {
  open
  satisfied_by_snapshot
  linked
  completed
  cancelled
  expired
  failed
}

enum ExecutionJobStatus {
  created
  queued
  reserved
  in_progress
  raw_committed
  writeback_pending
  succeeded
  failed
  cancelled
  expired
}

enum WritebackDeliveryStatus {
  pending
  applying
  applied
  retry_wait
  failed
  dead
  skipped
}

enum OutboxEventStatus {
  pending
  in_flight
  retry_wait
  processed
  dead
}

enum RawSnapshotQualityStatus {
  ok
  partial
  identity_mismatch
  lease_lost
  missing_metrics
  clock_skew_suspected
  invalid
}

enum TaxonomyNodeStatus {
  proposed
  active
  merged
  retired
}

enum ContentTagSubjectType {
  market_content
  topic
  demand_card
}

enum CommentSignalType {
  resonance
  conflict
  demand
  golden_quote
  story
  faq
  slang
  solution
}

enum DemandCardStatus {
  emerging
  active
  adopted
  dismissed
  archived
}

enum VoiceAssetStatus {
  active
  retired
  restricted
}

enum VoiceAssetPromotionSource {
  star
  signal_batch
  radar_evidence
  manual
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                          Session[]
  accounts                          Account[]
  memberships                       Member[]
  personnelGroupMemberships         PersonnelGroupMember[]
  invitations                       Invitation[]                   @relation("InvitationInviter")
  promotedVoiceAssets               VoiceAsset[]                   @relation("VoiceAssetPromoter")
  reviewedVoiceAssets               VoiceAsset[]                   @relation("VoiceAssetReviewer")
  voiceAssetLifecycleEvents         VoiceAssetLifecycleEvent[]     @relation("VoiceAssetLifecycleActor")
  createdVoiceAssetPacks            VoiceAssetPack[]               @relation("VoiceAssetPackCreator")
  reviewedVoiceSnippets             VoiceSnippet[]                 @relation("VoiceSnippetReviewer")
  reviewedVoiceSnippetFacets        VoiceSnippetFacet[]            @relation("VoiceSnippetFacetReviewer")
  reviewedDemandEvidence            DemandCardEvidenceAssessment[] @relation("DemandEvidenceReviewer")
  reviewedDemandSnapshots           DemandCardReviewSnapshot[]     @relation("DemandSnapshotReviewer")
  reviewedDemandTopics              DemandCardTopicSuggestion[]    @relation("DemandTopicSuggestionReviewer")
  createdResearchSessions           ResearchSession[]              @relation("ResearchSessionCreator")
  closedResearchSessions            ResearchSession[]              @relation("ResearchSessionCloser")
  pinnedResearchEvidence            ResearchEvidencePin[]          @relation("ResearchEvidencePinner")
  recordedResearchQueryRuns         ResearchQueryRun[]             @relation("ResearchQueryRunRecorder")
  createdCorpusPacks                CorpusPack[]                   @relation("CorpusPackCreator")
  initiatedCorpusRetrievals         CorpusRetrievalRun[]           @relation("CorpusRetrievalInitiator")
  recordedCorpusUsage               CorpusMaterialUsage[]          @relation("CorpusUsageRecorder")
  createdCorpusRankingPolicies      CorpusRankingPolicy[]          @relation("CorpusRankingPolicyCreator")
  createdCorpusExperiments          CorpusExperiment[]             @relation("CorpusExperimentCreator")
  createdSafetyProjectionBatches    CorpusSafetyProjectionBatch[]  @relation("CorpusSafetyProjectionBatchCreator")
  rolledBackSafetyProjectionBatches CorpusSafetyProjectionBatch[]  @relation("CorpusSafetyProjectionBatchRollbackActor")
}

model Session {
  id                   String   @id
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id        String   @id
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                     Member[]
  invitations                 Invitation[]
  voiceAssets                 VoiceAsset[]
  voiceAssetLifecycleEvents   VoiceAssetLifecycleEvent[]
  voiceAssetPacks             VoiceAssetPack[]
  voiceAssetPackItems         VoiceAssetPackItem[]
  voiceSnippets               VoiceSnippet[]
  dataLifecycleEvents         DataLifecycleEvent[]
  demandEvidenceAssessments   DemandCardEvidenceAssessment[]
  demandCardSnapshots         DemandCardReviewSnapshot[]
  demandCardTopicSuggestions  DemandCardTopicSuggestion[]
  researchSessions            ResearchSession[]
  researchEvidencePins        ResearchEvidencePin[]
  researchQueryRuns           ResearchQueryRun[]
  corpusPacks                 CorpusPack[]
  corpusRetrievalRuns         CorpusRetrievalRun[]
  corpusMaterialUsage         CorpusMaterialUsage[]
  corpusPackItems             CorpusPackItem[]
  corpusRankingPolicies       CorpusRankingPolicy[]
  corpusExperiments           CorpusExperiment[]
  corpusExperimentAssignments CorpusExperimentAssignment[]
  safetyProjectionBatches     CorpusSafetyProjectionBatch[]
  safetyProjectionBatchItems  CorpusSafetyProjectionBatchItem[]
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  roleProfile    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@index([organizationId, roleProfile])
}

model PersonnelGroup {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  status          String    @default("active")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  members PersonnelGroupMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([createdByUserId])
}

model PersonnelGroupMember {
  id          String   @id @default(cuid())
  workspaceId String
  groupId     String
  userId      String
  role        String   @default("member") // leader | member
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group PersonnelGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, groupId])
  @@index([workspaceId, role])
  @@index([userId])
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Topic {
  id          String    @id @default(cuid())
  workspaceId String?
  title       String
  summary     String?
  source      String
  sourceId    String?
  sourceUrl   String?
  sourceLabel String?
  status      String    @default("new")
  isFavorite  Boolean   @default(false)
  isUsed      Boolean   @default(false)
  publishedAt DateTime?

  logicTag         String?
  tensionCore      String?
  tensionType      String?
  reuseScore       String?
  contentValueRank Int     @default(0) // 内容价值等级（高=3/中=2/低=1/未评估=0），由 reuseScore 派生，供排序
  saturation       String?
  freshness        String?
  targetProduct    String?
  targetPlatform   String?
  persona          String?

  likes    Int @default(0)
  collects Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)

  bodyText         String?
  goldQuotes       String?
  rewriteFramework String?

  rawData String?

  sourceTag       String?
  hotScore        Int     @default(0)
  engagementRate  Float   @default(0)
  contentCategory String?
  trendScore      Int     @default(0)
  competitorFlag  Boolean @default(false)
  qualityGrade    String?
  platform        String?
  contentType     String?
  aiSummary       String?
  tensionScore    Int?
  rewriteCost     Int?

  // 作者信息（从 rawData 中提升为一等字段）
  authorId   String?
  authorName String?

  // 内容元数据
  platformContentId String? // 平台原生内容 ID
  contentAssetId    String?
  contentCode       String?
  ipLocation        String? // IP 属地
  hashtags          String? // JSON 数组格式存储

  // 媒体资源

  evaluationStatus        String    @default("none")
  evaluatedAt             DateTime?
  materialStatus          String?
  materialStatusUpdatedAt DateTime?
  assigneeUserId          String?
  reviewerUserId          String?
  createdByUserId         String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  lifecycleStatus String    @default("active")
  archivedAt      DateTime?
  archiveReason   String?
  version         Int       @default(0)

  tags                 TopicTag[]
  mediaSelections      TopicMediaSelection[]   @relation("TopicMediaSelections")
  suggestions          TopicSuggestion[]
  notifications        Notification[]
  skillExecutions      SkillExecution[]
  packItems            TopicPackItem[]
  decisionEvents       DecisionEvent[]
  signalTags           TopicSignalTag[]
  recommendationTraces RecommendationTrace[]
  contentAsset         ContentAsset?           @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  marketComparisons    TopicMarketComparison[]
  reviewJudgments      TopicReviewJudgment[]

  @@unique([workspaceId, id], map: "Topic_workspaceId_id_key")
  @@index([status])
  @@index([workspaceId])
  @@index([source])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([sourceTag])
  @@index([hotScore])
  @@index([contentValueRank]) // L1: 内容价值排序（reuseScore）
  @@index([contentCategory])
  @@index([qualityGrade])
  @@index([platform])
  @@index([contentAssetId])
  @@index([contentCode])
  @@index([workspaceId, materialStatus])
  @@index([workspaceId, assigneeUserId])
  @@index([workspaceId, reviewerUserId])
  @@index([workspaceId, createdByUserId])
  @@index([deletedAt])
  @@index([workspaceId, lifecycleStatus])
}

model OperationAccount {
  id                String    @id @default(cuid())
  workspaceId       String?
  platform          String // xhs | douyin
  accountName       String
  handle            String?
  deviceCode        String?
  profileUrl        String?
  followerCount     Int?
  ipLocation        String?
  operatorName      String?
  responsibleUserId String?
  createdByUserId   String?
  reviewStatus      String    @default("confirmed")
  isRetained        Boolean   @default(true)
  status            String    @default("active") // active | paused | archived
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([workspaceId, platform, accountName])
  @@index([workspaceId])
  @@index([platform])
  @@index([operatorName])
  @@index([workspaceId, responsibleUserId])
  @@index([workspaceId, reviewStatus])
  @@index([createdByUserId])
  @@index([isRetained])
  @@index([deletedAt])
}

model OperationPublication {
  id                  String    @id @default(cuid())
  workspaceId         String?
  platform            String // xhs | douyin
  platformContentId   String?
  contentAssetId      String?
  contentCode         String?
  publicationUrl      String?
  canonicalUrl        String?
  publishedAt         DateTime?
  title               String?
  copy                String?
  topicKeyword        String?
  topicTitle          String?
  imageType           String?
  postType            String?
  contentPosition     String?
  viewCount           Int?
  commentCount        Int?
  coverClickRate      Float?
  likeCount           Int?
  collectCount        Int?
  originalUrl         String?
  publisherName       String?
  responsibleUserId   String?
  createdByUserId     String?
  reviewStatus        String    @default("confirmed")
  accountName         String?
  operationAccountId  String?
  sourceTopicId       String?
  trafficCount        Int?
  leadCount           Int?
  viralAnalysis       String?
  issueAnalysis       String?
  notes               String?
  dataSyncStatus      String    @default("syncable") // syncable | synced | content_unavailable | needs_link | manual_fill | excluded
  dataSyncReason      String?
  dataSyncedAt        DateTime?
  dataSyncObservedAt  DateTime? // 最后一次被接受的同步事实时间；阻止迟到成功或失败覆盖新数据
  dataSyncRevisionKey String? // observedAt 相同时的类型化稳定裁决键，也是写回审计锚点
  source              String    @default("manual") // manual | csv_import | topic_publication_sync
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  contentAsset ContentAsset?      @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  media        PublicationMedia[] @relation("OperationPublicationMedia")

  @@unique([workspaceId, id], map: "OperationPublication_workspaceId_id_key")
  @@index([workspaceId])
  @@index([platform])
  @@index([platform, platformContentId])
  @@index([contentAssetId])
  @@index([contentCode])
  @@index([publishedAt])
  @@index([publisherName])
  @@index([workspaceId, responsibleUserId])
  @@index([workspaceId, reviewStatus])
  @@index([createdByUserId])
  @@index([accountName])
  @@index([operationAccountId])
  @@index([sourceTopicId])
  @@index([workspaceId, dataSyncStatus])
  @@index([deletedAt])
}

model DailyOperationMetric {
  id                     String    @id @default(cuid())
  workspaceId            String?
  date                   DateTime
  dateKey                String
  weekday                String?
  operatorName           String
  responsibleUserId      String?
  createdByUserId        String?
  reviewStatus           String    @default("confirmed")
  platform               String    @default("xhs") // xhs | douyin
  accountName            String    @default("")
  publishedCount         Int       @default(0)
  linksOpenedCount       Int       @default(0)
  followersGained        Int       @default(0)
  viralCount             Int       @default(0)
  monthlyFollowersGained Int       @default(0)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  @@unique([workspaceId, dateKey, operatorName, platform, accountName])
  @@index([workspaceId])
  @@index([dateKey])
  @@index([operatorName])
  @@index([workspaceId, responsibleUserId])
  @@index([workspaceId, reviewStatus])
  @@index([createdByUserId])
  @@index([platform])
  @@index([accountName])
  @@index([deletedAt])
}

// 运营目标设定（团队级，混合模式：未设定时前端回退历史估算）
model OperationTarget {
  id          String   @id @default(cuid())
  workspaceId String
  periodType  String // "week" | "month"
  periodKey   String // week: "2026-W28"（ISO 周）; month: "2026-07"
  metric      String   @default("followersGained")
  targetValue Int
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, periodType, periodKey, metric])
  @@index([workspaceId, periodType])
}

model DecisionReasonTag {
  id               String    @id @default(cuid())
  label            String    @unique
  displayName      String
  category         String
  description      String?
  usageCount       Int       @default(0)
  lastUsedAt       DateTime?
  isArchived       Boolean   @default(false)
  promotedFromText Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category, isArchived])
}

model DecisionEvent {
  id               String   @id @default(cuid())
  workspaceId      String?
  // 通用判断主体：topic | monitor_opportunity | ...（历史数据默认 topic）
  subjectType      String   @default("topic")
  subjectId        String?
  // topicId 仅在 subjectType=topic 时填写，保留与 Topic 的级联关系；其他主体为空
  topicId          String?
  topic            Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  action           String
  fromStatus       String?
  toStatus         String?
  reasonTags       String[] @default([])
  reasonText       String?
  contextSnapshot  Json
  actorType        String
  actorUserId      String
  actorAgentId     String?
  actorAgentVer    String?
  actorInvokedBy   String?
  agentContextHash String?
  createdAt        DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectType, subjectId, createdAt])
  @@index([topicId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model RecommendationTrace {
  id                 String    @id @default(cuid())
  workspaceId        String?
  topicId            String
  topic              Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  kind               String
  tier               String
  payload            Json
  evidenceTopicIds   String[]  @default([])
  counterExampleIds  String[]  @default([])
  citedPatternIds    String[]  @default([])
  confidenceNote     String?
  isTail             Boolean   @default(false)
  isSilentSignal     Boolean   @default(false)
  lifecycle          String    @default("suggested")
  userAction         String?
  userActionAt       DateTime?
  rejectReason       String?
  generatedForAction String?
  requesterType      String
  requesterUserId    String?
  requesterAgentId   String?
  audience           String    @default("human")
  createdAt          DateTime  @default(now())
  presentedAt        DateTime?
  dismissedAt        DateTime?

  @@index([workspaceId, topicId, createdAt])
  @@index([workspaceId, lifecycle, createdAt])
  @@index([topicId, lifecycle])
}

model CommentIngestion {
  id               String    @id @default(cuid())
  workspaceId      String?
  platform         String
  sourceId         String
  noteSourceId     String?
  taskId           String?
  sourceUrl        String?
  authorId         String?
  authorName       String?
  replyToCommentId String?
  replyToUserName  String?
  level            Int       @default(1)
  likes            Int       @default(0)
  content          String
  rawPayload       String
  // 评论树结构
  rootCommentId    String?
  commentEntityId  String?
  // 评论者信息
  profileUrl       String?
  // 时间信息
  publishedAt      DateTime?
  collectedAt      DateTime?
  // 位置信息
  ipLocation       String?
  status           String    @default("pending")
  errorMessage     String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  comment          Comment?

  @@unique([workspaceId, platform, sourceId])
  @@index([workspaceId])
  @@index([status])
  @@index([platform, noteSourceId])
  @@index([taskId])
  @@index([deletedAt])
}

model Comment {
  id                 String  @id @default(cuid())
  workspaceId        String?
  ingestionId        String? @unique
  platform           String
  sourceId           String
  noteSourceId       String?
  contentAssetId     String?
  contentCode        String?
  sourceUrl          String?
  authorId           String?
  authorName         String?
  replyToCommentId   String?
  replyToUserName    String?
  level              Int     @default(1)
  likes              Int     @default(0)
  content            String
  status             String  @default("ready")
  rawPayload         String?
  // P1-D4 的安全投影：保留原文不变，只有受控处理才会填充这些可空字段。
  normalizedText     String?
  redactedText       String?
  textSafetyVersion  String?
  piiStatus          String?
  safetyStatus       String?
  riskFlags          Json?
  writingEligibility String?

  // 评论树完整结构
  rootCommentId   String?
  commentEntityId String?

  // 评论者信息
  profileUrl String?

  // 时间信息
  publishedAt DateTime?
  collectedAt DateTime?

  // 位置信息
  ipLocation String?

  isStarred Boolean @default(false)

  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  deletedAt                  DateTime?
  lifecycleStatus            String                            @default("active")
  archivedAt                 DateTime?
  archiveReason              String?
  ingestion                  CommentIngestion?                 @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  cleaningReview             CommentCleaningReview?
  signals                    CommentSignal[]
  signalExtractionReceipts   CommentSignalExtractionReceipt[]
  star                       CommentStar?
  contentAsset               ContentAsset?                     @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  voiceAssets                VoiceAsset[]                      @relation("VoiceAssetSourceComment")
  voiceSnippets              VoiceSnippet[]                    @relation("VoiceSnippetSourceComment")
  safetyProjectionBatchItems CorpusSafetyProjectionBatchItem[]

  @@unique([workspaceId, platform, sourceId])
  @@index([workspaceId])
  @@index([platform, noteSourceId])
  @@index([contentAssetId])
  @@index([contentCode])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, lifecycleStatus])
  @@index([workspaceId, lifecycleStatus, deletedAt, createdAt, id])
}

model CommentCleaningReview {
  id               String    @id @default(cuid())
  workspaceId      String
  commentId        String    @unique
  status           String    @default("keep")
  reasons          Json
  confidence       Int       @default(0)
  ruleVersion      String
  contentHash      String
  contentPreview   String
  normalizedLength Int       @default(0)
  decidedByUserId  String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, ruleVersion, updatedAt])
}

model CommentSignal {
  id               String            @id @default(cuid())
  workspaceId      String
  commentId        String
  signalType       CommentSignalType
  summary          String
  quote            String
  taxonomyNodeId   String?
  strength         Int
  intentDepth      Int?
  extractorVersion String
  signalHash       String
  createdAt        DateTime          @default(now())

  comment        Comment               @relation(fields: [commentId], references: [id], onDelete: Cascade)
  taxonomyNode   TaxonomyNode?         @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  demandEvidence DemandCardEvidence[]
  voiceAssets    VoiceAsset[]          @relation("VoiceAssetSourceSignal")
  voiceSnippets  VoiceSnippet[]        @relation("VoiceSnippetSourceSignal")
  researchPins   ResearchEvidencePin[]

  @@unique([workspaceId, signalHash])
  @@index([workspaceId, signalType, createdAt])
  @@index([workspaceId, taxonomyNodeId, signalType])
  @@index([commentId])
}

// 每次当前版本的信号提取都必须留下回执：即便 AI 判断没有任何信号，
// 后续批处理也不能把它误当成“从未分析”而重复调用。
model CommentSignalExtractionReceipt {
  id                 String    @id @default(cuid())
  workspaceId        String
  commentId          String
  extractorVersion   String
  status             String    @default("completed")
  source             String    @default("ai")
  model              String?
  promptVersion      String?
  schemaVersion      String?
  contentHash        String
  signalCount        Int       @default(0)
  quoteRejectedCount Int       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  failureCode        String?
  tokenUsage         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, extractorVersion])
  @@index([workspaceId, extractorVersion, status, updatedAt])
}

model DemandCard {
  id                    String           @id @default(cuid())
  workspaceId           String
  taxonomyNodeId        String?
  title                 String
  status                DemandCardStatus @default(emerging)
  signalCount           Int              @default(0)
  distinctAuthorCount   Int              @default(0)
  highIntentAuthorCount Int              @default(0)
  representativeQuotes  Json
  marketValidation      Json?
  aggregationKey        String
  linkedTopicId         String?
  decidedByUserId       String?
  decidedAt             DateTime?
  firstSeenAt           DateTime         @default(now())
  lastSeenAt            DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  lifecycleStatus       String           @default("active")
  archivedAt            DateTime?
  archiveReason         String?

  taxonomyNode     TaxonomyNode?               @relation(fields: [taxonomyNodeId], references: [id], onDelete: SetNull)
  evidence         DemandCardEvidence[]
  reviewSnapshots  DemandCardReviewSnapshot[]
  topicSuggestions DemandCardTopicSuggestion[]
  researchPins     ResearchEvidencePin[]

  @@unique([workspaceId, aggregationKey])
  @@index([workspaceId, status, lastSeenAt])
  @@index([workspaceId, taxonomyNodeId, status])
  @@index([workspaceId, lifecycleStatus])
}

model DataLifecycleEvent {
  id          String   @id @default(cuid())
  workspaceId String
  subjectType String
  subjectId   String
  action      String
  reason      String
  actor       String
  createdAt   DateTime @default(now())

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, subjectType, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

model DemandCardEvidence {
  id              String   @id @default(cuid())
  workspaceId     String
  demandCardId    String
  commentSignalId String
  createdAt       DateTime @default(now())

  demandCard    DemandCard                    @relation(fields: [demandCardId], references: [id], onDelete: Cascade)
  commentSignal CommentSignal                 @relation(fields: [commentSignalId], references: [id], onDelete: Cascade)
  assessment    DemandCardEvidenceAssessment?

  @@unique([demandCardId, commentSignalId])
  @@index([workspaceId, demandCardId])
}

// P2A：对既有“需求卡 - 评论信号”关系补充可审核的证据角色。
// 历史关系没有这条记录时只表示“尚未分类”，不能被默认当作支持证据。
model DemandCardEvidenceAssessment {
  id                   String    @id @default(cuid())
  workspaceId          String
  demandCardEvidenceId String    @unique
  evidenceRole         String
  source               String    @default("human")
  status               String    @default("suggested")
  confidence           Float?
  rationale            String?
  assessorVersion      String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace          Organization       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  demandCardEvidence DemandCardEvidence @relation(fields: [demandCardEvidenceId], references: [id], onDelete: Cascade)
  reviewedBy         User?              @relation("DemandEvidenceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, evidenceRole, status, updatedAt])
  @@index([reviewedByUserId])
}

// P2A：每次采纳、驳回或重新开启都保留当时的样本与统计快照，避免后来新数据
// 让审核理由无法复现。
model DemandCardReviewSnapshot {
  id               String   @id @default(cuid())
  workspaceId      String
  demandCardId     String
  action           String
  metrics          Json
  evidenceSample   Json
  snapshotVersion  String
  reviewedByUserId String
  createdAt        DateTime @default(now())

  workspace  Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  demandCard DemandCard   @relation(fields: [demandCardId], references: [id], onDelete: Cascade)
  reviewedBy User         @relation("DemandSnapshotReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, demandCardId, createdAt])
  @@index([reviewedByUserId])
}

// P2A：正式主题只能先建议、再人工确认。它与旧 CommentTopic 和片段分类互不替代。
model DemandCardTopicSuggestion {
  id               String    @id @default(cuid())
  workspaceId      String
  demandCardId     String
  taxonomyNodeId   String
  source           String    @default("human")
  status           String    @default("suggested")
  confidence       Float?
  rationale        String?
  suggesterVersion String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  demandCard   DemandCard   @relation(fields: [demandCardId], references: [id], onDelete: Cascade)
  taxonomyNode TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("DemandTopicSuggestionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([demandCardId, taxonomyNodeId])
  @@index([workspaceId, status, updatedAt])
  @@index([taxonomyNodeId, status])
  @@index([reviewedByUserId])
}

// P2A：研究会话保存的是可复现的研究过程和结论草稿，不是正式需求结论。
model ResearchSession {
  id               String    @id @default(cuid())
  workspaceId      String
  title            String
  hypothesis       String?
  scopeDescription String?
  status           String    @default("draft")
  conclusionDraft  String?
  createdByUserId  String
  closedByUserId   String?
  closedAt         DateTime?
  lastQueryAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace    Organization          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("ResearchSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy     User?                 @relation("ResearchSessionCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  evidencePins ResearchEvidencePin[]
  queryRuns    ResearchQueryRun[]

  @@index([workspaceId, status, updatedAt])
  @@index([createdByUserId])
  @@index([closedByUserId])
}

// P2A：只保存一次检索的条件、命中量和数据快照，不复制评论正文。它让研究会话
// 能复现“当时按什么范围得出判断”，但不会把一次检索自动升级成正式需求结论。
model ResearchQueryRun {
  id                String   @id @default(cuid())
  workspaceId       String
  researchSessionId String
  queryText         String?
  filters           Json
  resultCount       Int
  totalCommentCount Int
  recordedFrom      String   @default("ui")
  snapshotAt        DateTime
  recordedByUserId  String
  createdAt         DateTime @default(now())

  workspace       Organization    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchSession ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation("ResearchQueryRunRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, researchSessionId, createdAt])
  @@index([recordedByUserId])
}

// P2A：研究者钉选有限的评论信号，明确记录选用理由和证据角色；删除来源信号时
// 不保留一份脱离来源的复制文本。
model ResearchEvidencePin {
  id                String   @id @default(cuid())
  workspaceId       String
  researchSessionId String
  commentSignalId   String
  demandCardId      String?
  evidenceRole      String   @default("background")
  selectionReason   String?
  pinnedByUserId    String
  createdAt         DateTime @default(now())

  workspace       Organization    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  researchSession ResearchSession @relation(fields: [researchSessionId], references: [id], onDelete: Cascade)
  commentSignal   CommentSignal   @relation(fields: [commentSignalId], references: [id], onDelete: Cascade)
  demandCard      DemandCard?     @relation(fields: [demandCardId], references: [id], onDelete: SetNull)
  pinnedBy        User            @relation("ResearchEvidencePinner", fields: [pinnedByUserId], references: [id], onDelete: Restrict)

  @@unique([researchSessionId, commentSignalId])
  @@index([workspaceId, researchSessionId, createdAt])
  @@index([commentSignalId])
  @@index([demandCardId])
  @@index([pinnedByUserId])
}

// P2B：一次写作任务的受限语料快照。它只引用经过当前安全门槛的资源，不能成为
// 未审核片段或原始评论的旁路。
model CorpusPack {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  purpose         String
  brief           String
  audienceJson    Json?
  platforms       Json?
  requestedSlots  Json
  retrievalRunId  String?
  querySnapshotAt DateTime
  taxonomyVersion String?
  rankingVersion  String
  status          String   @default("active")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Organization          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy    User                  @relation("CorpusPackCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  retrievalRun CorpusRetrievalRun?   @relation(fields: [retrievalRunId], references: [id], onDelete: SetNull)
  items        CorpusPackItem[]
  usage        CorpusMaterialUsage[]

  @@index([workspaceId, status, updatedAt])
  @@index([createdByUserId])
  @@index([retrievalRunId])
}

// P2B：包内只保存资源 ID、当时允许用途和选择理由，不复制用户原声。
model CorpusPackItem {
  id              String   @id @default(cuid())
  workspaceId     String
  corpusPackId    String
  resourceType    String
  resourceId      String
  voiceAssetId    String?
  voiceSnippetId  String?
  creativeRole    String
  rank            Int
  selectionReason String?
  allowedUse      String
  sourceGroup     String?
  sortOrder       Int
  createdAt       DateTime @default(now())

  workspace    Organization  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  corpusPack   CorpusPack    @relation(fields: [corpusPackId], references: [id], onDelete: Cascade)
  voiceAsset   VoiceAsset?   @relation(fields: [voiceAssetId], references: [id], onDelete: Restrict)
  voiceSnippet VoiceSnippet? @relation(fields: [voiceSnippetId], references: [id], onDelete: Restrict)

  @@unique([corpusPackId, resourceType, resourceId])
  @@index([workspaceId, corpusPackId, sortOrder])
  @@index([voiceAssetId])
  @@index([voiceSnippetId])
}

// P2B：每次受控检索都记录范围、版本、数量和证据不足提示；不记录原始评论正文。
model CorpusRetrievalRun {
  id                String   @id @default(cuid())
  workspaceId       String
  initiatedByUserId String
  agentRunId        String?
  briefHash         String
  queryPlan         Json
  filters           Json
  snapshotAt        DateTime
  resultCount       Int
  coverage          Json
  warnings          Json
  schemaVersion     String
  rankingVersion    String
  createdAt         DateTime @default(now())

  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  initiatedBy User         @relation("CorpusRetrievalInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  packs       CorpusPack[]

  @@index([workspaceId, createdAt])
  @@index([initiatedByUserId])
}

// P2B：使用账本只记录真实被选择、改写或未采用的材料关系；它不是模型调用次数统计。
model CorpusMaterialUsage {
  id               String   @id @default(cuid())
  workspaceId      String
  corpusPackId     String?
  voiceAssetPackId String?
  resourceType     String
  resourceId       String
  voiceAssetId     String?
  voiceSnippetId   String?
  contentAssetId   String?
  usageMode        String
  creativeRole     String?
  draftReference   String?
  contentReference String?
  agentRunId       String?
  usageTarget      String?
  adaptedText      String?
  finalText        String?
  note             String?
  recordedByUserId String
  usedAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  workspace             Organization                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  corpusPack            CorpusPack?                  @relation(fields: [corpusPackId], references: [id], onDelete: SetNull)
  voiceAssetPack        VoiceAssetPack?              @relation(fields: [voiceAssetPackId], references: [id], onDelete: SetNull)
  voiceAsset            VoiceAsset?                  @relation(fields: [voiceAssetId], references: [id], onDelete: Restrict)
  voiceSnippet          VoiceSnippet?                @relation(fields: [voiceSnippetId], references: [id], onDelete: Restrict)
  contentAsset          ContentAsset?                @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  recordedBy            User                         @relation("CorpusUsageRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  experimentAssignments CorpusExperimentAssignment[]

  @@index([workspaceId, usedAt])
  @@index([corpusPackId])
  @@index([voiceAssetPackId])
  @@index([voiceAssetId])
  @@index([voiceSnippetId])
  @@index([workspaceId, contentAssetId, usedAt])
  @@index([recordedByUserId])
}

// P4：排序反馈不直接写入材料或指标；它是可审计、可回滚的规则版本。
// configuration 只保存规则参数，内容表现仍只从 ContentMetricSnapshot 读取。
model CorpusRankingPolicy {
  id                 String    @id @default(cuid())
  workspaceId        String
  version            String
  status             String    @default("draft") // draft | active | rolled_back | archived
  sourceSummary      String?
  configuration      Json
  evidenceWindowDays Int       @default(28)
  activatedAt        DateTime?
  rolledBackAt       DateTime?
  rollbackReason     String?
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy User         @relation("CorpusRankingPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, version])
  @@index([workspaceId, status, updatedAt])
  @@index([createdByUserId])
}

// P4：实验只描述分组、假设和结论边界；没有预先登记的对照组，不允许它被解释为因果证明。
model CorpusExperiment {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  hypothesis      String
  status          String    @default("draft") // draft | running | completed | cancelled | archived
  scope           Json
  limitations     String?
  conclusion      String?
  startedAt       DateTime?
  endedAt         DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace   Organization                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy   User                         @relation("CorpusExperimentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignments CorpusExperimentAssignment[]

  @@index([workspaceId, status, updatedAt])
  @@index([createdByUserId])
}

// P4：允许对照内容没有语料使用记录；处理组必须在服务层核验使用记录与内容资产的关联。
model CorpusExperimentAssignment {
  id                    String   @id @default(cuid())
  workspaceId           String
  experimentId          String
  contentAssetId        String
  corpusMaterialUsageId String?
  variantKey            String
  isControl             Boolean  @default(false)
  assignedAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  workspace           Organization         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  experiment          CorpusExperiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  contentAsset        ContentAsset         @relation(fields: [contentAssetId], references: [id], onDelete: Restrict)
  corpusMaterialUsage CorpusMaterialUsage? @relation(fields: [corpusMaterialUsageId], references: [id], onDelete: SetNull)

  @@unique([experimentId, contentAssetId])
  @@index([workspaceId, experimentId, variantKey])
  @@index([contentAssetId])
  @@index([corpusMaterialUsageId])
}

// P1-D3：可用于创作检索的评论原文片段。它不是长期语料资产，必须保留
// 可机械核验的原文范围，并在审核完成前保持研究用途。
model VoiceSnippet {
  id                    String    @id @default(cuid())
  workspaceId           String
  sourceCommentId       String
  sourceSignalId        String?
  quoteText             String
  redactedText          String?
  quoteStart            Int
  quoteEnd              Int
  quoteHash             String
  sourceContentHash     String
  semanticType          String?
  expressionForm        String?
  creativeRole          String?
  specificityScore      Int?
  vividnessScore        Int?
  colloquialScore       Int?
  contextIntegrityScore Int?
  piiStatus             String    @default("unknown")
  safetyStatus          String    @default("unknown")
  allowedUse            String    @default("research_only")
  reviewStatus          String    @default("pending")
  extractorVersion      String    @default("manual-v1")
  reviewedByUserId      String?
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace          Organization          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceComment      Comment               @relation("VoiceSnippetSourceComment", fields: [sourceCommentId], references: [id], onDelete: Cascade)
  sourceSignal       CommentSignal?        @relation("VoiceSnippetSourceSignal", fields: [sourceSignalId], references: [id], onDelete: SetNull)
  reviewedBy         User?                 @relation("VoiceSnippetReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  facets             VoiceSnippetFacet[]
  corpusPackItems    CorpusPackItem[]
  corpusUsage        CorpusMaterialUsage[]
  derivedVoiceAssets VoiceAsset[]          @relation("VoiceAssetSourceSnippet")

  @@unique([workspaceId, sourceCommentId, quoteStart, quoteEnd, extractorVersion])
  @@index([workspaceId, reviewStatus, allowedUse, updatedAt])
  @@index([workspaceId, piiStatus, safetyStatus])
  @@index([sourceCommentId])
  @@index([sourceSignalId])
}

// P1-D5：分类字典与片段映射独立于正式主题。别名、版本、AI 建议和人工确认
// 都保留在这条链上，不能用旧 CommentTopic 或临时标签替代。
model CorpusFacetDimension {
  id           String   @id @default(cuid())
  key          String   @unique
  displayName  String
  description  String?
  version      Int      @default(1)
  isMultiValue Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  terms CorpusFacetTerm[]
}

model CorpusFacetTerm {
  id          String   @id @default(cuid())
  dimensionId String
  key         String
  displayName String
  description String?
  version     Int      @default(1)
  status      String   @default("active")
  aliasOfId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dimension CorpusFacetDimension @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  aliasOf   CorpusFacetTerm?     @relation("CorpusFacetTermAlias", fields: [aliasOfId], references: [id], onDelete: SetNull)
  aliases   CorpusFacetTerm[]    @relation("CorpusFacetTermAlias")
  snippets  VoiceSnippetFacet[]

  @@unique([dimensionId, key])
  @@index([dimensionId, status])
  @@index([aliasOfId])
}

model VoiceSnippetFacet {
  id               String    @id @default(cuid())
  workspaceId      String
  voiceSnippetId   String
  facetTermId      String
  source           String    @default("human")
  status           String    @default("suggested")
  confidence       Float?
  extractorVersion String?
  dimensionVersion Int
  termVersion      Int
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  voiceSnippet VoiceSnippet    @relation(fields: [voiceSnippetId], references: [id], onDelete: Cascade)
  facetTerm    CorpusFacetTerm @relation(fields: [facetTermId], references: [id], onDelete: Restrict)
  reviewedBy   User?           @relation("VoiceSnippetFacetReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([voiceSnippetId, facetTermId])
  @@index([workspaceId, status, updatedAt])
  @@index([facetTermId, status])
}

model VoiceAsset {
  id               String                    @id @default(cuid())
  workspaceId      String
  assetType        CommentSignalType
  quote            String
  contextNote      String?
  semanticType     String?
  expressionForm   String?
  valueTags        Json?
  creativeRoles    Json?
  sourceCommentId  String?
  sourceSignalId   String?
  sourceSnippetId  String?
  taxonomyNodeId   String?
  allowedUse       String?
  promotedByUserId String
  promotionSource  VoiceAssetPromotionSource
  reviewedByUserId String?
  reviewedAt       DateTime?
  status           VoiceAssetStatus          @default(active)
  retiredAt        DateTime?
  retiredReason    String?
  assetHash        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  workspace                  Organization                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  promotedBy                 User                              @relation("VoiceAssetPromoter", fields: [promotedByUserId], references: [id], onDelete: Restrict)
  reviewedBy                 User?                             @relation("VoiceAssetReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  sourceComment              Comment?                          @relation("VoiceAssetSourceComment", fields: [sourceCommentId], references: [id], onDelete: Restrict)
  sourceSignal               CommentSignal?                    @relation("VoiceAssetSourceSignal", fields: [sourceSignalId], references: [id], onDelete: Restrict)
  sourceSnippet              VoiceSnippet?                     @relation("VoiceAssetSourceSnippet", fields: [sourceSnippetId], references: [id], onDelete: Restrict)
  taxonomyNode               TaxonomyNode?                     @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)
  corpusPackItems            CorpusPackItem[]
  corpusUsage                CorpusMaterialUsage[]
  packItems                  VoiceAssetPackItem[]
  lifecycleEvents            VoiceAssetLifecycleEvent[]
  safetyProjectionBatchItems CorpusSafetyProjectionBatchItem[]

  @@unique([workspaceId, assetHash])
  @@index([workspaceId, assetType, taxonomyNodeId])
  @@index([workspaceId, status])
  @@index([workspaceId, status, allowedUse, reviewedAt])
  @@index([workspaceId, promotionSource, createdAt])
  @@index([sourceCommentId])
  @@index([sourceSignalId])
  @@index([sourceSnippetId])
  @@index([promotedByUserId])
  @@index([reviewedByUserId])
}

// P3：资产生命周期是追加事件，退役/限制不会覆盖原始晋升和来源事实。
model VoiceAssetLifecycleEvent {
  id                String            @id @default(cuid())
  workspaceId       String
  voiceAssetId      String
  action            String
  previousStatus    VoiceAssetStatus?
  nextStatus        VoiceAssetStatus?
  reason            String?
  metadata          Json?
  performedByUserId String
  occurredAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())

  workspace   Organization @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  voiceAsset  VoiceAsset   @relation(fields: [voiceAssetId], references: [id], onDelete: Restrict)
  performedBy User         @relation("VoiceAssetLifecycleActor", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([voiceAssetId, occurredAt])
  @@index([performedByUserId])
}

// H1/H2：历史安全投影批次账本只记录范围、摘要和补偿状态；不复制评论原文或资产文本。
model CorpusSafetyProjectionBatch {
  id                    String    @id @default(cuid())
  workspaceId           String
  batchKey              String
  status                String    @default("running")
  cutoff                DateTime
  inputCursor           String?
  nextCursor            String?
  candidateDigest       String
