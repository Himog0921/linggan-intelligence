model ExecutionQueueEntry {
  id                           String                    @id @default(cuid())
  // V1.1 主字段（手册第 4.5 节）：QueueEntry 以 jobId 关联 ExecutionJob。
  jobId                        String                    @unique
  workspaceId                  String?
  platform                     String
  source                       String
  lane                         String
  weight                       String                    @default("normal")
  priority                     Int                       @default(0)
  estimatedSeconds             Int                       @default(120) // 手册 6.3 lane 配额需要
  status                       ExecutionQueueEntryStatus @default(queued)
  availableAt                  DateTime?
  expiresAt                    DateTime? // reserved/in_progress 过期才有效
  // V1.1 reservation 三件套（手册 5.5 start_job 协议依赖）
  reservedByStationId          String?
  reservedPlatformAccountId    String?
  // 用于并发保护的执行身份。真实账号跨工位共享；浏览器会话只在所属工位内共享。
  reservedExecutionIdentityKey String?
  reserveToken                 String?
  reservationEpoch             Int                       @default(0)
  reservedUntil                DateTime?
  startBefore                  DateTime? // 未按时开始自动释放
  // V1.1 lease 三件套（手册第 4.5 节）：从 ExecutionTaskRuntime 迁移过来，QueueEntry 成为执行权权威
  leaseToken                   String?
  leaseEpoch                   Int                       @default(0)
  leaseExpiresAt               DateTime?
  // V1.1 失败归因（手册 5.10 failure-policy-service 依赖）
  attemptCount                 Int                       @default(0)
  lastAttemptId                String?
  lastErrorCode                String?
  lastErrorScope               String?
  lastErrorMessage             String?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  job ExecutionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, availableAt])
  @@index([platform, status, availableAt])
  @@index([source, status, availableAt])
  @@index([reservedByStationId])
  @@index([reserveToken])
  @@index([priority])
  // V1.1 索引（手册第 4.5 节），partial unique 索引走独立 SQL migration
  @@index([reservedUntil])
  @@index([leaseExpiresAt])
  @@index([workspaceId, platform, status])
}

