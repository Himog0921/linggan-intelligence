  origins          MediaOrigin[]          @relation("MediaItemOrigins")
  materializations MediaMaterialization[]
  usages           ContentMediaUsage[]
  topicSelections  TopicMediaSelection[]
  publicationMedia PublicationMedia[]
  authorMedia      AuthorMedia[]

  @@unique([workspaceId, id], map: "MediaItem_workspaceId_id_key")
  @@index([workspaceId, lifecycleState, createdAt])
}

// 选题的显式媒体选择关系。当前有效关系的唯一性由 migration.sql 的 partial unique index 保证。
model TopicMediaSelection {
  id               String    @id @default(cuid())
  workspaceId      String
  topicId          String
  mediaItemId      String
  purpose          String
  sourceRevision   String?
  selectedAt       DateTime  @default(now())
  selectedByUserId String?
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  createdAt        DateTime  @default(now())

  topic     Topic     @relation("TopicMediaSelections", fields: [workspaceId, topicId], references: [workspaceId, id], onDelete: Restrict)
  mediaItem MediaItem @relation(fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "TopicMediaSelection_workspaceId_id_key")
  @@index([workspaceId, topicId, purpose, validTo])
  @@index([workspaceId, mediaItemId, validTo])
}

// 发布媒体关系。预览与有序成品都只接受同一工作区中已经存在的 MediaItem。
model PublicationMedia {
  id                     String    @id @default(cuid())
  workspaceId            String
  operationPublicationId String
  mediaItemId            String
  purpose                String
  ordinal                Int?
  sourceRevision         String?
  selectedAt             DateTime  @default(now())
  selectedByUserId       String?
  validFrom              DateTime  @default(now())
  validTo                DateTime?
  createdAt              DateTime  @default(now())

  operationPublication OperationPublication @relation("OperationPublicationMedia", fields: [workspaceId, operationPublicationId], references: [workspaceId, id], onDelete: Restrict)
  mediaItem            MediaItem            @relation(fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "PublicationMedia_workspaceId_id_key")
  @@index([workspaceId, operationPublicationId, purpose, ordinal, validTo])
  @@index([workspaceId, mediaItemId, validTo])
}

// 作者级媒体关系。头像不属于任何 ContentAsset，因此不能挂 ContentMediaUsage；
// 它与 TopicMediaSelection / PublicationMedia 同构，是媒体域的第四张业务关系表。
//
// purpose 先只收 `avatar` 一个值：作者级媒体将来可能扩展（主页背景等），但
// 词表开宽就是给缺口留门，需要时再经准入流程扩。
// 当前有效关系的唯一性由 migration.sql 的 partial unique index 保证。
model AuthorMedia {
  id               String    @id @default(cuid())
  workspaceId      String
  authorId         String
  mediaItemId      String
  purpose          String
  sourceRevision   String?
  selectedAt       DateTime  @default(now())
  selectedByUserId String?
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  createdAt        DateTime  @default(now())

  author    Author    @relation(fields: [workspaceId, authorId], references: [workspaceId, id], onDelete: Restrict)
  mediaItem MediaItem @relation(fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id], map: "AuthorMedia_workspaceId_id_key")
  @@index([workspaceId, authorId, purpose, validTo])
  @@index([workspaceId, mediaItemId, validTo])
}

model MediaOrigin {
  id                String    @id @default(cuid())
  workspaceId       String
  mediaItemId       String
  provider          String
  stableLocator     String
  fetchUrl          String?
  fetchUrlExpiresAt DateTime?
  generation        Int       @default(1)
  originState       String    @default("observed")
  observedAt        DateTime  @default(now())
  lastResolvedAt    DateTime?
  lastErrorCode     String?
  nextRetryAt       DateTime?
  deletedAt         DateTime?

  mediaItem        MediaItem              @relation("MediaItemOrigins", fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)
  materializations MediaMaterialization[]
  contentMediaUsages ContentMediaUsage[] @relation("ContentMediaUsageOrigin")

  @@unique([workspaceId, id], map: "MediaOrigin_workspaceId_id_key")
  @@unique([workspaceId, id, mediaItemId], map: "MediaOrigin_workspaceId_id_mediaItemId_key")
  @@index([mediaItemId])
  @@index([workspaceId, originState, nextRetryAt])
}

model MediaMaterialization {
  id               String    @id @default(cuid())
  workspaceId      String
  mediaItemId      String
  mediaOriginId    String
  originGeneration Int
  blobId           String?
  state            String    @default("pending")
  materializedAt   DateTime?
  supersededAt     DateTime?
  createdAt        DateTime  @default(now())

  mediaItem MediaItem   @relation(fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)
  origin    MediaOrigin @relation(fields: [workspaceId, mediaOriginId, mediaItemId], references: [workspaceId, id, mediaItemId], onDelete: Restrict)
  blob      MediaBlob?  @relation(fields: [workspaceId, blobId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([mediaOriginId, originGeneration])
  @@index([workspaceId, mediaItemId, supersededAt])
  @@index([blobId])
}

model ContentMediaUsage {
  id                       String    @id @default(cuid())
  workspaceId              String
  contentAssetId           String
  mediaItemId              String
  purpose                  String
  ordinal                  Int?
  // B3-PROJECTION-FOUNDATION-001: canonical provenance (all-or-nothing).
  contractEvaluationId     String?
  canonicalObservationId   String?
  canonicalSlotId          String?
  mediaOriginId            String?
  originGeneration         Int?
  mediaProcessingEventId   String?
  sourceRevision           String?
  observedAt               DateTime?
  validFrom                DateTime  @default(now())
  validTo                  DateTime?
  createdAt                DateTime  @default(now())

  contentAsset       ContentAsset          @relation(fields: [workspaceId, contentAssetId], references: [workspaceId, id], onDelete: Restrict)
  mediaItem          MediaItem             @relation(fields: [workspaceId, mediaItemId], references: [workspaceId, id], onDelete: Restrict)
  contractEvaluation ContractEvaluation?   @relation("ContentMediaUsageEvaluation", fields: [workspaceId, contractEvaluationId], references: [workspaceId, id], onDelete: Restrict, map: "CMU_evaluation_fkey")
  canonicalSlot      CanonicalMediaSlot?   @relation("ContentMediaUsageSlot", fields: [workspaceId, canonicalObservationId, canonicalSlotId], references: [workspaceId, canonicalObservationId, slotId], onDelete: Restrict, map: "CMU_slot_fkey")
  mediaOrigin        MediaOrigin?          @relation("ContentMediaUsageOrigin", fields: [workspaceId, mediaOriginId, mediaItemId], references: [workspaceId, id, mediaItemId], onDelete: Restrict, map: "CMU_origin_fkey")
  processingEvent    OutboxEvent?          @relation("MediaUsageProcessingEvent", fields: [mediaProcessingEventId], references: [id], onDelete: Restrict, map: "CMU_processing_event_fkey")

  @@unique([workspaceId, id], map: "ContentMediaUsage_workspaceId_id_key")
  @@index([workspaceId, contentAssetId, purpose, ordinal])
  @@index([mediaItemId])
  @@index([canonicalObservationId])
}

// 内容资产的「理解结果」：封面/多图 OCR、口播转录、视频理解。
//
// 为什么挂在 ContentAsset 而不是 Topic：同一条笔记可能既在选题库里、也被监控/雷达引用，
// 库外笔记（cw note pack）根本没有 Topic。理解是内容本身的属性，不是某个选题的属性。
// 选题侧通过 Topic.contentAssetId 桥接读取，两边看到同一份结果。
//
// role 使用媒体账本的业务槽位词表（cover / image:{index} / video），一一对应具体素材。
model ContentAssetUnderstanding {
  id             String   @id @default(cuid())
  workspaceId    String
  contentAssetId String
  // kind 是「哪一类理解」，role 是「作用在哪个素材上」。封面 OCR 不单列 kind——
  // 它就是 kind=image_ocr + role=cover，这样查一条笔记的全部图片文字只需一次查询。
  kind           String // image_ocr | video_transcript | video_understanding
  role           String // cover | image:{index} | video
  provider       String // doubao_cover_understanding | local_mlx_whisper | ...
  model          String?
  status         String   @default("completed") // completed | failed
  ocrText        String? // 图片里识别出的文字 / 口播文本
  summary        String? // 视觉摘要或内容摘要
  payload        Json? // 完整原始结果（textLayout / riskNotes / segments 等）
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)

  // 同一张图的同一种理解只保留一条，重跑就地覆盖。
  @@unique([contentAssetId, kind, role])
  @@index([workspaceId])
  @@index([contentAssetId])
  @@index([kind])
}

// 调度 tick 日志：记录每轮 dispatch/maintenance tick 的执行情况，便于回溯排查。
// 替代原先只进 console 的 logExecutionTaskSchedulerTick——容器重启后历史 tick 全失。
model SchedulerTickLog {
  id            String    @id @default(cuid())
  workspaceId   String?
  mode          String // dispatch | maintenance
  skipped       Boolean   @default(false)
  startedAt     DateTime
  finishedAt    DateTime?
  durationMs    Int       @default(0)
  stepDurations Json? // [{ step, durationMs }]
  errors        Json? // [{ step, message }]
  metrics       Json? // 各 step 的 metric 摘要（planner/recovery/scheduler 等）
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([mode, createdAt])
  @@index([workspaceId, createdAt])
}

// 平台熔断状态变化事件：记录 open/degraded/normal 的转换历史。
// evaluatePlatformCircuitBreakers 本身保持只读纯计算，状态变化在 maintenance tick 里持久化，
// 解决"熔断纯内存、重启归零、无法回溯打开/恢复时间线"的缺口。
model PlatformCircuitBreakerEvent {
  id            String    @id @default(cuid())
  workspaceId   String?
  platform      String
  state         String // normal | degraded | open
  previousState String?
  reason        String?
  failureCount  Int       @default(0)
  stationCount  Int       @default(0)
  retryAt       DateTime?
  createdAt     DateTime  @default(now())

  @@index([platform, createdAt])
  @@index([workspaceId, platform, createdAt])
  @@index([createdAt])
}

// ============================================================================
// V1.1 采集架构重构目标模型（手册 target-architecture-handbook-v1.1.md 第 4 节）
// 现役链路以 ExecutionJob / ExecutionQueueEntry / RawSnapshot / WritebackDelivery 为主。
// 所有 partial unique index 走独立 SQL migration
// （prisma/migrations/features/collection-refactor-indexes.sql）
// ============================================================================

// 手册 4.1：平台对象标准化身份，解决同一 URL / 博主 / 作品多种形式重复创建任务。
model PlatformTarget {
  id                 String    @id @default(cuid())
  workspaceId        String
  platform           String
  targetType         String // note | author | keyword | comment_thread
  targetKey          String
  aliasOfTargetKey   String?
  platformContentId  String?
  platformAuthorId   String?
  keywordHash        String?
  canonicalUrl       String?
  rawUrlVariants     Json?
  title              String?
  authorName         String?
  status             String    @default("active") // active | deleted | private | invalid | unknown
  // 失效确认标记（2026-07-08，笔记失效归因修复）：status="invalid" 时以下字段生效。
  // 只在多次确认后才写入（沿用 PR#41 已验证的 24h 内失败≥3 次阈值），避免网络抖动
  // 误杀。invalidReleasedAt 非空表示人工解除，恢复排单资格；不清空 status，
  // 造单入口读取时需同时检查 status 与 invalidReleasedAt。
  invalidConfirmedAt DateTime?
  invalidReasonCode  String? // 确认失效时的终态错误码，如 content_not_found
  invalidEvidence    String? // 最后一次失败的错误摘要，供排障
  invalidSourceLane  String? // 触发确认的来源，如 monitor | operation_data_sync | data_governance
  invalidReleasedAt  DateTime? // 人工解除时间，非空即视为已解除
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  lastObservedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, platform, targetKey])
  @@index([workspaceId, platform, aliasOfTargetKey])
  @@index([workspaceId, platform, targetType])
  @@index([workspaceId, platform, platformContentId])
  @@index([workspaceId, platform, platformAuthorId])
  @@index([workspaceId, platform, status])
}

// 手册 4.2：业务需求层。所有业务入口必须先创建 Demand，禁止直接创建 ExecutionJob。
// requiredFields 必须是字段名数组（V1.1 设计拍板 1）。
model TaskDemand {
  id                           String                          @id @default(cuid())
  workspaceId                  String
  sourceSystem                 String // manual | monitor | operation_data_sync | data_governance | topic_material | author_archive
  sourceRequestId              String // 永久唯一幂等键（手册 L335-343）
  sourceRecordId               String?
  platform                     String
  targetType                   String
  targetKey                    String
  platformTargetId             String?
  demandKind                   String // metrics | detail | comments | author_profile | archive
  requiredFields               Json // 字段名数组（V1.1 设计拍板 1）
  collectionProfile            String // list_scan | note_detail | note_full | comment_probe | author_profile | author_links
  // freshness：latest 必须有 maxSnapshotAgeSec（V1.1 致命 Bug 3）
  freshnessType                String // latest | max_age | checkpoint | force_new
  maxSnapshotAgeSec            Int?
  checkpointType               String?
  checkpointAnchorType         String?
  checkpointDueAt              DateTime?
  checkpointToleranceBeforeSec Int?
  checkpointToleranceAfterSec  Int?
  priority                     Int                             @default(50)
  slaClass                     String                          @default("normal") // hot | normal | cold
  expiresAt                    DateTime?
  expiredPolicy                String                          @default("skip") // skip | downgrade | keep | manual_review
  status                       TaskDemandStatus                @default(open) // open | satisfied_by_snapshot | linked | completed | cancelled | expired | failed
  linkedJobId                  String?
  linkedSnapshotId             String?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt
  completedAt                  DateTime?
  cancelledAt                  DateTime?
  idempotencyHash              String?
  idempotencyPayload           Json?
  links                        TaskDemandLink[]
  archiveBackfillPlanItems     AuthorArchiveBackfillPlanItem[] @relation("ArchiveBackfillPlanItemTaskDemand")

  @@unique([workspaceId, sourceSystem, sourceRequestId])
  @@index([workspaceId, status, priority, createdAt])
  @@index([workspaceId, platform, targetKey, status])
  @@index([workspaceId, checkpointDueAt])
  @@index([workspaceId, expiresAt])
}

// 手册 4.4：Demand 与 Job 的多对一绑定（多业务共用一个 Job）。
model TaskDemandLink {
  id          String       @id @default(cuid())
  workspaceId String
  demandId    String
  jobId       String
  role        String       @default("consumer")
  createdAt   DateTime     @default(now())
  demand      TaskDemand   @relation(fields: [demandId], references: [id], onDelete: Restrict)
  job         ExecutionJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([demandId, jobId])
  @@index([jobId])
  @@index([workspaceId, demandId])
}

// 手册 4.3：一次实际采集作业。多个 TaskDemand 可共用一个 ExecutionJob。
// activeDedupeKey + partial unique index 是防 TOCTOU 的兜底（V1.1 致命 Bug 2）。
model ExecutionJob {
  id                   String             @id @default(cuid())
  workspaceId          String
  platform             String
  targetType           String
  targetKey            String
  platformTargetId     String?
  jobType              String // collect_metrics | collect_detail | collect_comments | collect_author | deep_archive
  collectionProfile    String
  requiredFields       Json
  payload              Json
  // DEC-B1-023: server-owned opaque plan identity. Historical rows may remain
  // null; every new Prisma-created job gets one value that retries must reuse.
  // A changed execution plan is represented by a new ExecutionJob.
  executionPlanVersion String?            @default(cuid())
  activeDedupeKey      String? // sha256(workspace+platform+targetKey+profile+requiredFields+depth)
  priority             Int                @default(50)
  lane                 String // manual_hot | monitor_checkpoint | monitor_patrol | data_sync | governance | archive | comments
  estimatedSeconds     Int                @default(120)
  notBeforeAt          DateTime?
  expiresAt            DateTime?
  status               ExecutionJobStatus @default(created) // created | queued | reserved | in_progress | raw_committed | writeback_pending | succeeded | failed | cancelled | expired
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  completedAt          DateTime?

  // V1.1 UI 切换阻塞 2/4 解除：保留业务态细分（taskType/source/taskStrategy/monitorId），
  // 供 UI 读模型（listCollectionTasks / findTaskById / monitor-detail）按 monitorId 索引
  // 历史并精确显示 taskType / source / taskStrategy。由 createExecutionJobForDemand
  // 从 jobPayload 回填，存量行由 scripts/migration/07-backfill-executionjob-original-fields.ts 回填。
  originalTaskType     String? // xhs.batchNotes | xhs.collectAuthor | ... 共 8 种业务态
  originalSource       String? // manual | monitor | operation_data_sync | data_governance | topic_material | author_archive
  originalTaskStrategy String? // author_baseline | author_patrol | keyword_patrol | detail_probe | comment_sweep
  monitorId            String? // 仅 source=monitor 入口回填；manual/data_sync/governance 为 null

  // V1.1 影子层下线前置（08-backfill-executionjob-rich-fields.ts）：
  // 把 CollectionTask 的 rich UI 字段镜像到 ExecutionJob，让 ExecutionJob 成为
  // 采集结果的权威主表。这些字段之前只存在 CollectionTask 上，UI 读 CollectionTask
  // 才能显示 target/resultSummary/notesImported/commentsImported/authorsImported 等。
  // 回填完成后，UI 切到 ExecutionJob 主表即可下线 CollectionTask 影子层。
  target                 String? // raw URL（UI 显示用；ExecutionJob.targetKey 是规范化的，不含原 URL）
  resultSummary          String? // 采集结果摘要（JSON；与 CollectionTask.resultSummary 同语义）
  latestSummary          String? // 最新观察快照（JSON；与 CollectionTask.latestSummary 同语义）
  notesImported          Int       @default(0) // 本次采集导入的笔记数
  commentsImported       Int       @default(0) // 本次采集导入的评论数
  authorsImported        Int       @default(0) // 本次采集导入的作者数
  operationPublicationId String? // 仅 source=operation_data_sync 入口回填
  roundId                String? // 仅 source=monitor 入口回填（与 monitorId 配对）
  deletedAt              DateTime? // 软删（UI 默认排除）

  // V1.1 影子层下线（2026-06-27）：6 张依赖表的 FK 已重新指向 ExecutionJob.id。
  // ExecutionJob 现在是采集执行链路的权威父表。
  runtime                  ExecutionTaskRuntime?
  writeback                ExecutionTaskWriteback?
  queueEntry               ExecutionQueueEntry?
  attempts                 TaskAttempt[]
  demandLinks              TaskDemandLink[]
  writebackDeliveries      WritebackDelivery[]
  archiveCommentRunItems   AuthorArchiveItem[]             @relation("ArchiveRunItemCommentTask")
  archiveBackfillPlanItems AuthorArchiveBackfillPlanItem[] @relation("ArchiveBackfillPlanItemExecutionJob")
  // V1.1 写回重构（2026-06-27）：records 反向 relation 已删除（CollectionTaskRecord 表 DROP）。
  // record 数据走 RawRecord（通过 jobId 字段关联，无 schema relation）。

  @@index([workspaceId, platform, targetKey, status])
  @@index([workspaceId, lane, status, priority])
  @@index([workspaceId, monitorId])
  @@index([workspaceId, operationPublicationId])
  @@index([workspaceId, deletedAt])
}

// V1.1 影子层下线（2026-06-27）：事件流权威表。
//
// 背景：CollectionTaskEvent 原本是任务事件的唯一事实源，但 CollectionTaskEvent.taskId
// 有 FK→CollectionTask.id（onDelete: Cascade），与"CollectionTask 不再写入"目标冲突。
// 在 ExecutionTaskRuntime / ExecutionTaskWriteback / ExecutionQueueEntry / TaskAttempt /
// CollectionTaskEvent / CollectionTaskRecord 全部 FK 重新指向 ExecutionJob 之前，无法
// 停止写 CollectionTask（FK 锚点）。
//
// 本表是事件流去耦合的第一步：collection-task-observation-service 的事件写入
// （createTaskEvent / createIdempotentTaskEvent）从 CollectionTaskEvent 切换到本表；
// jobId 即 ExecutionJob.id（不再依赖 CollectionTask 行存在）。UI 详情页/更新页读取
// 也相应切换。CollectionTaskEvent 保留只读（历史数据），不再写入。
//
// 字段语义与 CollectionTaskEvent 一一对应（便于后续把历史数据迁移过来）：
//   - jobId         即 ExecutionJob.id（与 CollectionTask.id 1:1，向后兼容旧影子）
//   - sequence      任务内单调递增（同 ExecutionTaskRuntime.sequenceCursor 派生）
//   - idempotencyKey 幂等键（同 taskId+idempotencyKey 唯一约束）
//   - eventType     同 ExecutionTaskEventType 词表（task.created/started/progress/...）
//   - payload       JSON 字符串（与 CollectionTaskEvent.payload 同形式）
model ExecutionJobEvent {
  id             String   @id @default(cuid())
  workspaceId    String?
  jobId          String
  sequence       Int
  idempotencyKey String?
  eventType      String
  source         String   @default("workbench")
  message        String?
  payload        String?
  pluginRunId    String?
  createdAt      DateTime @default(now())

  @@unique([jobId, idempotencyKey])
  @@unique([jobId, sequence])
  @@index([workspaceId])
  @@index([jobId, sequence])
  @@index([jobId, createdAt])
  @@index([eventType])
  @@index([pluginRunId])
}

// 任务执行全链路日志（给调度状态弹窗和排障查询使用）。
// 与 ExecutionJobEvent 不同，本表按 job / queueEntry / attempt / rawSnapshot /
// writebackDelivery 等跨链路维度建索引，用于回答“为什么排队、派给谁、插件交了什么、
// 是否入库、哪里失败”。
model ExecutionLogEvent {
  id                  String   @id @default(cuid())
  workspaceId         String?
  jobId               String?
  demandId            String?
  queueEntryId        String?
  taskAttemptId       String?
  rawSnapshotId       String?
  rawRecordId         String?
  writebackDeliveryId String?
  stationId           String?
  platform            String?
  lane                String?
  source              String?
  eventType           String
  stage               String
  status              String?
  title               String
  message             String?
  reasonCode          String?
  details             Json?
  occurredAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([jobId, occurredAt])
  @@index([queueEntryId, occurredAt])
  @@index([demandId, occurredAt])
  @@index([taskAttemptId, occurredAt])
  @@index([rawSnapshotId, occurredAt])
  @@index([writebackDeliveryId, occurredAt])
  @@index([stationId, occurredAt])
  @@index([eventType, occurredAt])
}

// V2 B1 Release-A：CapturePackage is the immutable physical package.  It is
// additive only in this release; no runtime path writes it until the B1
// EvidenceIngress cutover has passed isolated-database proof.
model CapturePackage {
  id                String        @id @default(cuid())
  workspaceId       String
  packagePayload    Bytes
  checksumAlgorithm String        @default("sha256")
  checksumValue     String
  contentLength     Int
  restricted        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  rawSnapshots      RawSnapshot[] @relation("RawSnapshotCapturePackage")
  accessAudits      EvidenceAccessAudit[] @relation("CapturePackageAudit")

  @@unique([workspaceId, id])
}

// V2 B1 Release-A：entry receipts are immutable evidence-ingress facts.
model EvidenceIngressReceipt {
  id               String      @id @default(dbgenerated("gen_random_uuid()::text"))
  workspaceId      String
  rawSnapshotId    String
  captureId        String
  ingressKind      String
  collectorVersion String
  receivedAt       DateTime    @default(now())
  rawSnapshot      RawSnapshot @relation("RawSnapshotIngressReceipt", fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "EvidenceIngressReceipt_workspace_snapshot_fkey")
  v2DurableWorks   V2DurableWork[] @relation("V2DurableWorkReceipt")

  @@unique([workspaceId, rawSnapshotId])
  @@unique([workspaceId, id])
  @@index([workspaceId, receivedAt])
}

// V2 B1 Release-A：an artifact is metadata for a capture package, never a
// second payload store.  The underlying file, if any, remains managed by the
// established local-media storage boundary.
model CaptureArtifact {
  id               String      @id @default(cuid())
  workspaceId      String
  rawSnapshotId    String
  kind             String
  artifactChecksum String
  restricted       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  rawSnapshot      RawSnapshot @relation("RawSnapshotCaptureArtifacts", fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "CaptureArtifact_workspace_snapshot_fkey")

  @@unique([workspaceId, id])
  @@unique([workspaceId, rawSnapshotId, id])
}

// V2 Release-B: EvidenceAccessAudit — append-only log recording every controlled
// CapturePackage read. One INSERT per read; no UPDATE/DELETE.
model EvidenceAccessAudit {
  id               String         @id @default(dbgenerated("gen_random_uuid()::text"))
  workspaceId      String
  capturePackageId String
  accessedBy       String
  accessReason     String
  requestTraceId   String?
  restricted       Boolean        @default(false)
  accessedAt       DateTime       @default(now())
  capturePackage   CapturePackage @relation("CapturePackageAudit", fields: [workspaceId, capturePackageId], references: [workspaceId, id], onDelete: Restrict, map: "EvidenceAccessAudit_workspace_package_fkey")

  @@index([workspaceId, capturePackageId])
}

// V2 Release-B: EvidenceReaderWorkspaceGrant — per-workspace reader authorisation.
model EvidenceReaderWorkspaceGrant {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  workspaceId String
  readerRole  String
  grantedAt   DateTime  @default(now())
  grantedBy   String
  revokedAt   DateTime?

  @@unique([workspaceId, readerRole])
}

// V2 Release-B: V2DurableWork — durable B2/B3 dispatch.
// Created in same transaction as EvidenceIngress (no best-effort enqueue).
// FK to RawSnapshot + EvidenceIngressReceipt ensures same-workspace provenance.
model V2DurableWork {
  id             String                    @id @default(dbgenerated("gen_random_uuid()::text"))
  workspaceId    String
  rawSnapshotId  String
  receiptId      String
  status         String                    @default("pending")
  attemptCount   Int                       @default(0)
  nextAttemptAt  DateTime                  @default(now())
  lockedBy       String?
  lockedAt       DateTime?
  leaseExpiresAt DateTime?
  lastError      String?
  deadReason     String?
  b2Result       Json?
  b3Result       Json?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now()) @updatedAt

  rawSnapshot RawSnapshot           @relation("V2DurableWorkSnapshot", fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "V2DurableWork_snapshot_fkey")
  receipt     EvidenceIngressReceipt @relation("V2DurableWorkReceipt", fields: [workspaceId, receiptId], references: [workspaceId, id], onDelete: Restrict, map: "V2DurableWork_receipt_fkey")

  @@unique([workspaceId, rawSnapshotId])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, status])
}

// 手册 4.7：原始结果包不可变。重传同 captureId 不重复创建（不变量 7）。
// checksum 必须在写对象存储前按 raw bytes 计算（V1.1 致命 Bug 4）。
model RawSnapshot {
  id                     String                    @id @default(cuid())
  workspaceId            String
  // V2 Release-A permits non-execution Evidence (manual import, recovery and
  // migration) without inventing an ExecutionJob or TaskAttempt.  V1 writers
  // still provide both fields until the Release-B ingress hard cutover.
  jobId                  String?
  attemptId              String?
  captureId              String
  platform               String
  targetKey              String
  expectedTargetKey      String?
  observedTargetKey      String?
  observedAt             DateTime
  receivedAt             DateTime                  @default(now())
  clientObservedAt       DateTime?
  clockSkewSeconds       Int?
  observedAtSource       String? // client | server_clamped
  storageKey             String? // raw/{workspaceId}/{jobId}/{attemptId}/{leaseEpoch}/{captureId}.json
  checksumAlgorithm      String?
  checksumValue          String?
  contentLength          Int?
  // 06-raw-storage-decision：原始结果包本轮先存 PostgreSQL，不引入 Vercel Blob。
  // 小包直接存 payloadClob；未来启用对象存储时填 storageKey，payloadClob 可置空或存摘要。
  payloadClob            String? // 原始 JSON 包（canonical bytes）
  // Release-B prepare: nullable so V2 EvidenceIngress can write null without
  // a fabricated V1 value; existing V1 rows keep their defaults.
  schemaVersion          String?
  pluginVersion          String?
  stationId              String?
  qualityStatus          RawSnapshotQualityStatus? @default(ok) // ok | partial | identity_mismatch | lease_lost | missing_metrics | clock_skew_suspected | invalid
  qualityReason          String?
  // 2026-07-13 报告 §9.3：快照来源。plugin_sync = 正常执行链路写回；
  // plugin_local_recovery = 显式恢复导入（插件本地账本/死信导出后人工导入，
  // 可审计、可去重，不伪造旧 TaskAttempt 成功）。
  // Release-B prepare: nullable for V2 EvidenceIngress (writes null).
  source                 String?                   @default("plugin_sync")
  // V2 EvidenceIngress fields.  They intentionally remain nullable in
  // Release-A so existing historical observations stay readable without any
  // invented backfill.  Release-B makes them mandatory only after the hard
  // ingress cutover.
  ingressKind            String?
  capturePackageId       String?
  protocolVersion        String?
  collectorVersion       String?
  sourcePrincipal        String?
  sourceSummary          String?
  importerIdentity       String?
  migrationAuthorization String?
  recoveryCaptureId      String?
  recoveryAuthorizedBy   String?
  leaseEpoch             Int?
  executionPlanVersion   String?
  integrityStatus        String?
  integrityReason        String?
  // Server-owned Evidence lifecycle. New V2 Evidence starts ACTIVE; legacy
  // rows remain null rather than being falsely backfilled as active.
  lifecycleStatus        String?
  contractId             String?
  contractVersion        Int?
  contractHash           String?
  createdAt              DateTime                  @default(now())
  records                RawRecord[]
  v2DurableWorks         V2DurableWork[]          @relation("V2DurableWorkSnapshot")
  capturePackage         CapturePackage?           @relation("RawSnapshotCapturePackage", fields: [workspaceId, capturePackageId], references: [workspaceId, id], onDelete: Restrict, map: "RawSnapshot_workspace_capturePackage_fkey")
  ingressReceipt         EvidenceIngressReceipt?   @relation("RawSnapshotIngressReceipt")
  captureArtifacts       CaptureArtifact[]         @relation("RawSnapshotCaptureArtifacts")
  normalizationRuns      NormalizationRun[]        @relation("RawSnapshotNormalizationRuns")
  contractEvaluations    ContractEvaluation[]      @relation("RawSnapshotContractEvaluations")

  // Release-A keeps the V1 selector and uniqueness for rows without a V2
  // CapturePackage. V2 variants are deduplicated by the complete package hash,
  // while only one verified variant may become normalization input.
  @@unique([workspaceId, captureId], name: "workspaceId_captureId", map: "RawSnapshot_workspaceId_captureId_key", where: { capturePackageId: null })
  @@unique([workspaceId, captureId, checksumAlgorithm, checksumValue], name: "workspaceId_captureId_checksumAlgorithm_checksumValue", map: "RawSnapshot_v2_capture_variant_key", where: { capturePackageId: { not: null } })
  @@unique([workspaceId, captureId], name: "workspaceId_captureId_v2_verified", map: "RawSnapshot_v2_verified_capture_key", where: raw("\"capturePackageId\" IS NOT NULL AND \"integrityStatus\" = 'verified'"))
  @@unique([workspaceId, id])
  @@index([workspaceId, platform, targetKey, observedAt])
  @@index([workspaceId, jobId])
  @@index([workspaceId, source])
}

// 手册 4.8：原始结果中的结构化记录。
model RawRecord {
  id                      String                    @id @default(cuid())
  workspaceId             String
  rawSnapshotId           String
  jobId                   String?
  // Release-B prepare: nullable so V2 writes recordKind instead; V1 readers
  // that filter on recordType must guard for null (fail-closed).
  recordType              String? // note | comment | author | metric
  // Release-A writes no value here.  Release-B replaces recordType with this
  // field after the immutable ingress path is live and verified.
  recordKind              String?
  platform                String
  targetKey               String?
  externalRecordId        String?
  sequence                Int?
  payload                 Json
  payloadHash             String?
  observedAt              DateTime
  collectedAt             DateTime?
  idempotencyKey          String
  dedupeKey               String?
  createdAt               DateTime                  @default(now())
  // Release-B prepare: compound FK ensures RawRecord cannot reference a
  // RawSnapshot in a different workspace.
  rawSnapshot             RawSnapshot               @relation(fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "RawRecord_workspace_snapshot_fkey")
  normalizationRuns       NormalizationRun[]        @relation("RawRecordNormalizationRuns")
  normalizationRunCurrent NormalizationRunCurrent[] @relation("RawRecordNormalizationRunCurrent")
  canonicalObservations   CanonicalObservation[]    @relation("RawRecordCanonicalObservations")

  // Release-B prepare: idempotency scoped to (workspaceId, rawSnapshotId,
  // idempotencyKey) — prevents cross-snapshot merge or skip.
  @@unique([workspaceId, rawSnapshotId, idempotencyKey])
  @@unique([workspaceId, rawSnapshotId, id])
  @@index([workspaceId, platform, targetKey])
  @@index([rawSnapshotId])
}

// V2 B2: one immutable interpretation attempt for one RawRecord.
model NormalizationRun {
  id                     String                               @id @default(cuid())
  workspaceId            String
  rawSnapshotId          String
  rawRecordId            String
  adapterId              String
  adapterVersion         String
  canonicalSchemaVersion String
  attemptNumber          Int                                  @default(1)
  status                 String
  inputPayloadHash       String
  outputPayloadHash      String?
  missingFields          Json?
  parseErrors            Json?
  startedAt              DateTime                             @default(now())
  completedAt            DateTime                             @default(now())
  createdAt              DateTime                             @default(now())
  rawSnapshot            RawSnapshot                          @relation("RawSnapshotNormalizationRuns", fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "NormalizationRun_workspace_snapshot_fkey")
  rawRecord              RawRecord                            @relation("RawRecordNormalizationRuns", fields: [workspaceId, rawSnapshotId, rawRecordId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "NormalizationRun_workspace_snapshot_record_fkey")
  currentPointers        NormalizationRunCurrent[]            @relation("NormalizationRunCurrentRun")
  canonicalObservations  CanonicalObservation[]               @relation("CanonicalObservationNormalizationRun")
  contractEvaluations    ContractEvaluationNormalizationRun[] @relation("ContractEvaluationNormalizationRunRun")

  @@unique([rawRecordId, adapterId, adapterVersion, canonicalSchemaVersion, attemptNumber], map: "NormalizationRun_record_adapter_attempt_key")
  @@unique([workspaceId, id], map: "NormalizationRun_workspace_id_key")
  @@unique([workspaceId, rawSnapshotId, id], map: "NormalizationRun_workspace_snapshot_id_key")
}

// V2 B2: mutable selector for the current immutable NormalizationRun.
model NormalizationRunCurrent {
  workspaceId            String
  rawRecordId            String
  rawSnapshotId          String
  normalizationRunId     String
  adapterId              String
  adapterVersion         String
  canonicalSchemaVersion String
  updatedAt              DateTime         @default(now()) @updatedAt
  normalizationRun       NormalizationRun @relation("NormalizationRunCurrentRun", fields: [workspaceId, rawSnapshotId, normalizationRunId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "NormalizationRunCurrent_workspace_snapshot_run_fkey")
  rawRecord              RawRecord        @relation("RawRecordNormalizationRunCurrent", fields: [workspaceId, rawSnapshotId, rawRecordId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "NormalizationRunCurrent_workspace_snapshot_record_fkey")

  @@id([workspaceId, rawRecordId], map: "NormalizationRunCurrent_pkey")
  @@unique([workspaceId, normalizationRunId], map: "NormalizationRunCurrent_workspace_run_key")
  @@unique([workspaceId, rawSnapshotId, rawRecordId], map: "NormalizationRunCurrent_workspace_snapshot_record_key")
}

// V2 B2 technical interpretation result; Domain Projection remains B3.
model CanonicalObservation {
  id                 String                    @id @default(cuid())
  workspaceId        String
  normalizationRunId String
  rawSnapshotId      String
  rawRecordId        String
  observationKind    String
  subjectKey         String
  observedAt         DateTime
  schemaVersion      String
  payload            Json
  payloadHash        String
  qualityStatus      String
  fieldPresence      Json?
  createdAt          DateTime                  @default(now())
  normalizationRun   NormalizationRun          @relation("CanonicalObservationNormalizationRun", fields: [workspaceId, rawSnapshotId, normalizationRunId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "CanonicalObservation_workspace_snapshot_run_fkey")
  rawRecord          RawRecord                 @relation("RawRecordCanonicalObservations", fields: [workspaceId, rawSnapshotId, rawRecordId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "CanonicalObservation_workspace_snapshot_record_fkey")
  contractInputs     ContractEvaluationInput[] @relation("ContractEvaluationInputObservation")
  mediaSlots         CanonicalMediaSlot[]      @relation("CanonicalObservationMediaSlots")
  contentObservations ContentObservation[]     @relation("ContentObsCanonical")

  @@unique([workspaceId, id], map: "CanonicalObservation_workspace_id_key")
  @@unique([workspaceId, rawSnapshotId, id], map: "CanonicalObservation_workspace_snapshot_id_key")
  @@unique([workspaceId, rawSnapshotId, id, rawRecordId], map: "CanonicalObservation_workspace_snapshot_record_key")
}

// V2 B3-MEDIA-SRC-002: immutable media slot registry per design-freeze §5.12.
// Slots are always created from a verified media_inventory Artifact. No URL,
// CDN, localPath, MediaItemId, or OCR fields — this is a canonical observation
// fact, not a delivery record.
model CanonicalMediaSlot {
  id                     String              @id @default(cuid())
  workspaceId            String
  canonicalObservationId String
  slotId                 String
  status                 String              // observed | absent | unavailable
  kind                   String
  ordinal                Int
  canonicalObservation   CanonicalObservation @relation("CanonicalObservationMediaSlots", fields: [workspaceId, canonicalObservationId], references: [workspaceId, id], onDelete: Restrict, map: "CanonicalMediaSlot_workspace_observation_fkey")
  contentMediaUsages     ContentMediaUsage[]   @relation("ContentMediaUsageSlot")

  @@unique([workspaceId, canonicalObservationId, slotId], map: "CanonicalMediaSlot_workspace_observation_slot_key")
  @@unique([workspaceId, id], map: "CanonicalMediaSlot_workspace_id_key")
}

// V2 B3-PROJECTION-FOUNDATION-001: Content Observation + Current Projection.
model ContentObservation {
  id                     String              @id @default(cuid())
  workspaceId            String
  contentAssetId         String
  canonicalObservationId String
  rawSnapshotId          String
  rawRecordId            String
  observedAt             DateTime
  contentType            String?
  title                  String?
  bodyText               String?
  publishedAt            DateTime?
  authorId               String?
  originalUrl            String?
  fieldPresence          Json?
  qualityStatus          String
  adapterVersion         String
  createdAt              DateTime            @default(now())

  contentAsset         ContentAsset         @relation("ContentAssetObservations", fields: [workspaceId, contentAssetId], references: [workspaceId, id], onDelete: Restrict)
  canonicalObservation CanonicalObservation @relation("ContentObsCanonical", fields: [workspaceId, rawSnapshotId, canonicalObservationId, rawRecordId], references: [workspaceId, rawSnapshotId, id, rawRecordId], onDelete: Restrict, map: "ContentObservation_canonical_4col_fkey")
  currentProjection    ContentCurrentProjection? @relation("CurrentObsPtr")

  @@unique([workspaceId, id], map: "ContentObservation_workspace_id_key")
  @@unique([workspaceId, contentAssetId, id], map: "ContentObservation_asset_id_key")
  @@unique([workspaceId, contentAssetId, canonicalObservationId], map: "ContentObservation_asset_canonical_key")
}

model ContentCurrentProjection {
  contentAssetId        String   @id
  workspaceId           String
  currentObservationId  String
  contractEvaluationId  String
  title                 String?
  bodyText              String?
  contentType           String?
  publishedAt           DateTime?
  authorId              String?
  originalUrl           String?
  lastObservedAt        DateTime
  projectionVersion     Int      @default(1)
  lifecycleState        String?
  visibilityState       String   @default("visible")
  updatedAt             DateTime @default(now()) @updatedAt

  contentAsset  ContentAsset        @relation("ContentAssetCurrentProjection", fields: [workspaceId, contentAssetId], references: [workspaceId, id], onDelete: Restrict)
  observation   ContentObservation  @relation("CurrentObsPtr", fields: [workspaceId, contentAssetId, currentObservationId], references: [workspaceId, contentAssetId, id], onDelete: Restrict, map: "CCP_observation_fkey")
  contractEvaluation ContractEvaluation @relation("ContentCurrentProjectionEvaluation", fields: [workspaceId, contractEvaluationId], references: [workspaceId, id], onDelete: Restrict, map: "CCP_evaluation_fkey")

  @@unique([workspaceId, contentAssetId], map: "CCP_workspace_asset_key")
  @@unique([workspaceId, contentAssetId, currentObservationId], map: "CCP_workspace_asset_observation_key")
  @@index([workspaceId])
}

// V2 B3 internal serialization fence. This is coordination state only, not a
// business fact or a Projection read model.
model ContentProjectionSubjectFence {
  workspaceId       String
  platformContentId String
  generation        BigInt   @default(0)
  updatedAt         DateTime @default(now()) @updatedAt

  @@id([workspaceId, platformContentId], map: "ContentProjectionSubjectFence_pkey")
}

// V2 B2 append-only contract decision for one RawSnapshot.
model ContractEvaluation {
  id                     String                               @id @default(cuid())
  workspaceId            String
  rawSnapshotId          String
  contractId             String
  contractVersion        Int
  evaluatorVersion       String
  canonicalSchemaVersion String
  evaluationInputHash    String
  decision               String
  completeness           String
  rejectionCode          String?
  rejectionReason        String?
  createdAt              DateTime                             @default(now())
  rawSnapshot            RawSnapshot                          @relation("RawSnapshotContractEvaluations", fields: [workspaceId, rawSnapshotId], references: [workspaceId, id], onDelete: Restrict, map: "ContractEvaluation_workspace_snapshot_fkey")
  currentPointers        ContractEvaluationCurrent[]          @relation("ContractEvaluationCurrentEvaluation")
  normalizationRuns      ContractEvaluationNormalizationRun[] @relation("ContractEvaluationNormalizationRunEvaluation")
  inputs                 ContractEvaluationInput[]            @relation("ContractEvaluationInputEvaluation")
  currentContentProjections ContentCurrentProjection[]        @relation("ContentCurrentProjectionEvaluation")
  contentMediaUsages       ContentMediaUsage[]                @relation("ContentMediaUsageEvaluation")

  @@unique([workspaceId, rawSnapshotId, contractId, contractVersion, evaluatorVersion, canonicalSchemaVersion, evaluationInputHash], map: "ContractEvaluation_identity_key")
  @@unique([workspaceId, id, rawSnapshotId, contractId, contractVersion], map: "ContractEvaluation_workspace_contract_id_key")
  @@unique([workspaceId, rawSnapshotId, id], map: "ContractEvaluation_workspace_snapshot_id_key")
  @@unique([workspaceId, id], map: "ContractEvaluation_workspace_id_key")
}

// V2 B2 mutable selector for the current immutable ContractEvaluation.
model ContractEvaluationCurrent {
  workspaceId          String
  rawSnapshotId        String
  contractId           String
  contractVersion      Int
  contractEvaluationId String
  revision             Int
  updatedAt            DateTime           @default(now()) @updatedAt
  contractEvaluation   ContractEvaluation @relation("ContractEvaluationCurrentEvaluation", fields: [workspaceId, contractEvaluationId, rawSnapshotId, contractId, contractVersion], references: [workspaceId, id, rawSnapshotId, contractId, contractVersion], onDelete: Restrict, map: "ContractEvaluationCurrent_workspace_evaluation_fkey")

  @@id([workspaceId, rawSnapshotId, contractId, contractVersion], map: "ContractEvaluationCurrent_pkey")
}

// V2 B2 immutable provenance edge from an evaluation to a normalization run.
model ContractEvaluationNormalizationRun {
  id                 String             @id @default(cuid())
  evaluationId       String
  normalizationRunId String
  workspaceId        String
  rawSnapshotId      String
  status             String
  inputPayloadHash   String
  outputPayloadHash  String?
  createdAt          DateTime           @default(now())
  contractEvaluation ContractEvaluation @relation("ContractEvaluationNormalizationRunEvaluation", fields: [workspaceId, rawSnapshotId, evaluationId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "ContractEvaluationNormalizationRun_workspace_evaluation_fkey")
  normalizationRun   NormalizationRun   @relation("ContractEvaluationNormalizationRunRun", fields: [workspaceId, rawSnapshotId, normalizationRunId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "ContractEvaluationNormalizationRun_workspace_run_fkey")

  @@unique([evaluationId, normalizationRunId], map: "ContractEvaluationNormalizationRun_evaluation_run_key")
  @@unique([workspaceId, id], map: "ContractEvaluationNormalizationRun_workspace_id_key")
}

// V2 B2 immutable ordered input edge from an evaluation to an observation.
model ContractEvaluationInput {
  id                     String               @id @default(cuid())
  workspaceId            String
  rawSnapshotId          String
  contractEvaluationId   String
  canonicalObservationId String
  ordinal                Int
  canonicalOutputHash    String
  createdAt              DateTime             @default(now())
  contractEvaluation     ContractEvaluation   @relation("ContractEvaluationInputEvaluation", fields: [workspaceId, rawSnapshotId, contractEvaluationId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "ContractEvaluationInput_workspace_evaluation_fkey")
  canonicalObservation   CanonicalObservation @relation("ContractEvaluationInputObservation", fields: [workspaceId, rawSnapshotId, canonicalObservationId], references: [workspaceId, rawSnapshotId, id], onDelete: Restrict, map: "ContractEvaluationInput_workspace_observation_fkey")

  @@unique([contractEvaluationId, canonicalObservationId], map: "ContractEvaluationInput_evaluation_observation_key")
  @@unique([contractEvaluationId, ordinal], map: "ContractEvaluationInput_evaluation_ordinal_key")
  @@unique([workspaceId, id], map: "ContractEvaluationInput_workspace_id_key")
}

// 手册 4.10：当前最新值投影。
// 必须使用 UPSERT，禁止 UPDATE-only（V1.1 致命 Bug 1）。
// latest 唯一判断依据是 observedAt，不能用 MAX(likeCount)。
model ContentMetricLatest {
  id                     String    @id @default(cuid())
  workspaceId            String
  platform               String
  targetKey              String
  latestSnapshotId       String
  observedAt             DateTime
  likeCount              Int?
  likeCountObservedAt    DateTime?
  collectCount           Int?
  collectCountObservedAt DateTime?
  commentCount           Int?
  commentCountObservedAt DateTime?
  shareCount             Int?
  shareCountObservedAt   DateTime?
  viewCount              Int?
  viewCountObservedAt    DateTime?
  updatedAt              DateTime  @updatedAt

  @@unique([workspaceId, platform, targetKey])
}

// 手册 4.11：发布后 / 首次发现后 / 起量后检查点。
// checkpointType 含 SURGE_T* —— Surge 起量追踪若未实现则从 enum 删除（V1.1 协议补齐 4）。
model MonitorCheckpoint {
  id                   String    @id @default(cuid())
  workspaceId          String
  monitorId            String?
  platform             String
  targetKey            String
  checkpointType       String // BASELINE | T1H | T6H | T24H | T72H | T7D | SURGE_T1H | SURGE_T6H | SURGE_T24H | SURGE_T72H
  anchorType           String // PUBLISHED_AT | FIRST_SEEN_AT | SURGE_STARTED_AT
  anchorAt             DateTime
  dueAt                DateTime
  toleranceBeforeSec   Int
  toleranceAfterSec    Int
  finalizationDelaySec Int       @default(7200)
  selectedSnapshotId   String?
  selectedObservedAt   DateTime?
  deviationSeconds     Int?
  baselineSnapshotId   String?
  deltaLikeCount       Int?
  deltaCollectCount    Int?
  deltaCommentCount    Int?
  deltaShareCount      Int?
  deltaWeightedScore   Float?
  status               String    @default("pending") // pending | due | provisional | final | gap | corrected | target_lost | cancelled
  gapReason            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  finalizedAt          DateTime?

  @@unique([workspaceId, platform, targetKey, checkpointType, anchorType, anchorAt])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, platform, targetKey, dueAt])
}

// 手册 4.12：多业务独立写回。一个 RawSnapshot 可扇出多个 WritebackDelivery。
// 必须有 required / blockingPolicy / terminalDisposition（V1.1 设计拍板 3）。
// 写回失败不触发重新采集（不变量 14）。匹配用 sourceRecordId / targetKey，禁止模糊查找（不变量 12）。
model WritebackDelivery {
  id                  String                  @id @default(cuid())
  workspaceId         String
  demandId            String
  jobId               String
  rawSnapshotId       String?
  targetSystem        String
  targetRecordId      String?
  targetKey           String
  expectedTargetKey   String?
  observedTargetKey   String?
  processorVersion    String
  idempotencyKey      String                  @unique
  required            Boolean                 @default(true)
  blockingPolicy      String                  @default("required") // required | optional | best_effort
  terminalDisposition String? // applied | skipped | dead_non_blocking | dead_blocking | cancelled_target_missing
  status              WritebackDeliveryStatus @default(pending) // pending | applying | applied | retry_wait | failed | dead | skipped
  attemptCount        Int                     @default(0)
  nextAttemptAt       DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  lastAppliedAt       DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  job                 ExecutionJob            @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, nextAttemptAt])
  @@index([demandId])
  @@index([jobId])
  @@index([rawSnapshotId])
}

// 手册 4.13：所有异步处理走 Outbox。outbox-worker-service.ts 必须实现（V1.1 交付补齐 1）。
model OutboxEvent {
  id            String            @id @default(cuid())
  workspaceId   String?
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(pending) // pending | in_flight | retry_wait | processed | dead
  attemptCount  Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lockedBy      String?
  lockedAt      DateTime?
  lastError     String?
  deadCategory  String?
  createdAt     DateTime          @default(now())
  processedAt   DateTime?
  mediaUsageProcessingEvents ContentMediaUsage[] @relation("MediaUsageProcessingEvent")

  @@index([status, nextAttemptAt])
  @@index([status, processedAt])
  @@index([aggregateType, aggregateId])
}

// 手册 4.14：UI 读模型。UI 禁止现场 join 多张事实表（不变量 16）。
model TaskStatusProjection {
  jobId            String    @id
  workspaceId      String
  sourceSystems    Json?
  platform         String
  targetKey        String
  lane             String?
  executionStatus  String
  writebackStatus  String
  analysisStatus   String?
  currentStationId String?
  currentAccountId String?
  failureCode      String?
  failureScope     String?
  displayMessage   String?
  progress         Int?
  nextRetryAt      DateTime?
  lastEventAt      DateTime?
  updatedAt        DateTime  @updatedAt

  // V1.1 UI 切换阻塞 3 解除：runtime 详情列补齐。UI 详情页直接读这三列展示
  // plugin 运行 ID / lease 过期时间 / 派单时间。由 updateTaskStatusProjection 回填 +
  // 存量由 scripts/migration/07-backfill-executionjob-original-fields.ts 从
  // ExecutionTaskRuntime 复制到本投影。
  pluginRunId    String?
  leaseExpiresAt DateTime?
  dispatchedAt   DateTime?

  @@index([workspaceId, executionStatus, updatedAt])
  @@index([workspaceId, platform, targetKey])
}

// 手册 4.14：账号健康投影。
model AccountHealthProjection {
  id                 String    @id @default(cuid())
  workspaceId        String
  platform           String
  platformAccountId  String
  healthStatus       String
  cooldownUntil      DateTime?
  riskControlUntil   DateTime?
  riskControlCode    String?
  recentFailureScore Int       @default(0)
  lastFailureCode    String?
  lastFailureAt      DateTime?
  displayMessage     String?
  updatedAt          DateTime  @updatedAt

  @@unique([workspaceId, platform, platformAccountId])
}

// 手册 4.16：lane 级 mailbox。与现有 ExecutionStationMailbox 配合降低空闲查询。
// version bump 规则见手册 4.16 末尾。
model ExecutionLaneMailbox {
  id            String   @id @default(cuid())
  workspaceId   String
  platform      String
  lane          String
  version       Int      @default(0)
  pendingCount  Int      @default(0)
  lastChangedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workspaceId, platform, lane])
}

// ============================================================================
// V2-M1 主题坐标系
// ============================================================================

model TaxonomyNode {
  id               String             @id @default(cuid())
  workspaceId      String
  parentId         String?
  slug             String
  name             String
  level            Int
  status           TaxonomyNodeStatus @default(proposed)
  mergedIntoId     String?
  description      String?
  aliasKeywords    Json
  proposedBy       String
  approvedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  parent                     TaxonomyNode?               @relation("TaxonomyNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                   TaxonomyNode[]              @relation("TaxonomyNodeTree")
  mergedInto                 TaxonomyNode?               @relation("TaxonomyNodeMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom                 TaxonomyNode[]              @relation("TaxonomyNodeMerge")
  contentTopicTags           ContentTopicTag[]
  performanceRollups         TopicPerformanceRollup[]
  commentSignals             CommentSignal[]
  demandCards                DemandCard[]
  voiceAssets                VoiceAsset[]
  voiceAssetPacks            VoiceAssetPack[]
  demandCardTopicSuggestions DemandCardTopicSuggestion[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, parentId])
  @@index([workspaceId, status])
}

model ContentTopicTag {
  id             String                @id @default(cuid())
  workspaceId    String
  taxonomyNodeId String
  subjectType    ContentTagSubjectType
  subjectKey     String
  confidence     Float
  taggerVersion  String
  source         String
  createdAt      DateTime              @default(now())

  taxonomyNode TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, taxonomyNodeId, subjectType, subjectKey], map: "ContentTopicTag_workspaceId_taxonomyNodeId_subjectType_subjectK")
  @@index([workspaceId, subjectType, subjectKey])
  @@index([workspaceId, taxonomyNodeId, subjectType])
}

model TopicPerformanceRollup {
  id              String   @id @default(cuid())
  workspaceId     String
  taxonomyNodeId  String
  platform        String
  windowKey       String
  sampleCount     Int
  viralCount      Int
  medianLikeCount Int
  p90LikeCount    Int
  topExampleKeys  Json
  rollupVersion   String
  computedAt      DateTime

  taxonomyNode TaxonomyNode @relation(fields: [taxonomyNodeId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, taxonomyNodeId, platform, windowKey], map: "TopicPerformanceRollup_workspace_node_platform_window_key")
  @@index([workspaceId, platform, windowKey])
  @@index([workspaceId, taxonomyNodeId])
}

// ============================================================================
// V1.1 目标模型结束
// ============================================================================
