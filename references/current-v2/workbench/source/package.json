{
  "name": "topic-dashboard",
  "version": "0.14.3",
  "private": true,
  "bin": {
    "cw": "bin/cw.mjs"
  },
  "scripts": {
    "dev": "node scripts/ensure-local-postgres.cjs && next dev",
    "build": "prisma generate && next build && node scripts/enforce-next-output-trace-boundaries.mjs && node scripts/verify-next-output-trace-boundaries.mjs && node scripts/write-runtime-build-fingerprint.mjs",
    "prestart": "node scripts/verify-runtime-build-fingerprint.mjs",
    "start": "next start",
    "test": "vitest run",
    "cw:next": "node packages/cli/src/bin.mjs",
    "cw:smoke": "node scripts/cw-cli-smoke.mjs",
    "cw:pack-check": "node scripts/cw-pack-check.mjs",
    "cw:e2e": "node scripts/cw-real-e2e.mjs",
    "cw:mcp": "node packages/mcp-server/src/index.mjs",
    "cw:contracts": "tsx scripts/generate-cli-task-contracts.mts",
    "cw:contracts:check": "tsx scripts/generate-cli-task-contracts.mts --check",
    "cw:api-guard": "node scripts/cw-api-route-guard.mjs",
    "cw:release-guard": "node scripts/cw-release-guard.mjs",
    "cw:publish-check": "node scripts/cw-release-artifact.mjs --dry-run",
    "cw:release-artifact": "node scripts/cw-release-artifact.mjs",
    "cw-agent:publish-check": "node scripts/cw-agent-release-artifact.mjs --dry-run",
    "cw-agent:release-artifact": "node scripts/cw-agent-release-artifact.mjs",
    "cw:release-check": "node scripts/cw-release-check.mjs",
    "governance:check": "node scripts/check-project-governance.mjs",
    "worker:outbox": "tsx scripts/outbox-worker.ts",
    "metrics:backfill-latest": "tsx scripts/backfill-content-metric-latest.ts",
    "verify:queue-repair": "tsx scripts/verify-queue-integrity-repair.ts",
    "verify:archive-discovery-reconciliation": "tsx scripts/verify-author-archive-discovery-reconciliation.ts",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "corpus:migration-fingerprint": "node scripts/corpus-migration-fingerprint.mjs",
    "corpus:migration-rehearsal": "node scripts/corpus-migration-rehearsal.mjs",
    "corpus:migration-rehearsal-repair": "node scripts/repair-corpus-rehearsal-migration-ledger.mjs",
    "corpus:migration-local-repair": "node scripts/promote-corpus-local-migration-ledger-repair.mjs",
    "corpus:voice-assets:history-preview": "tsx scripts/preview-corpus-voice-asset-history.ts",
    "corpus:voice-assets:safety-projection": "tsx scripts/apply-corpus-voice-asset-safety-projection.ts",
    "media:single-track-static-scan": "node scripts/single-track-media-static-scan.mjs",
    "media:hard-cutover-preflight": "tsx scripts/preflight-media-library-hard-cutover.ts",
    "v2:single-track-static-scan": "tsx scripts/v2/single-track-static-scan.ts",
    "v2:cutover-preflight": "tsx scripts/v2/cutover-preflight.ts",
    "v2:worker-readiness": "tsx scripts/v2/probe-worker-readiness.ts",
    "v2:content-canary": "tsx scripts/ops/run-v2-content-canary.ts",
    "v2:record-cutover-state": "tsx scripts/v2/record-cutover-state.ts",
    "v2:provision-runtime-security": "tsx scripts/v2/provision-runtime-security.ts",
    "db:local:start": "docker compose -p topic-dashboard-local -f docker-compose.local.yml up -d --wait",
    "db:local:stop": "docker compose -p topic-dashboard-local -f docker-compose.local.yml stop",
    "db:local:down": "docker compose -p topic-dashboard-local -f docker-compose.local.yml down",
    "db:local:reset": "docker compose -p topic-dashboard-local -f docker-compose.local.yml down -v",
    "db:local:restore": "node scripts/restore-local-backup.mjs --yes",
    "db:local:logs": "docker compose -p topic-dashboard-local -f docker-compose.local.yml logs -f postgres",
    "db:push": "prisma db push",
    "db:pool-check": "node scripts/db-connection-pool-check.mjs",
    "db:index-audit": "tsx scripts/db-index-audit.mjs",
    "xhs:normalize-author-urls": "tsx scripts/normalize-xhs-author-profile-urls.ts",
    "blob:local:restore": "node scripts/restore-local-blob.mjs --yes",
    "architecture:file-size-audit": "node scripts/service-file-size-audit.mjs",
    "architecture:execution-status-audit": "tsx scripts/execution-task-status-audit.mjs",
    "architecture:execution-task-split-audit": "tsx scripts/execution-task-split-audit.mjs",
    "architecture:execution-queue-audit": "tsx scripts/execution-queue-audit.mjs",
    "architecture:execution-entrypoint-guard": "tsx scripts/dedup/guard-execution-entrypoints.ts",
    "author-archive:audit": "tsx scripts/audit-author-archive.ts",
    "author-archive:health": "tsx scripts/audit-author-archive-health.ts",
    "transcript-quality:audit": "tsx scripts/audit-transcript-quality.ts",
    "schema:json-text-audit": "node scripts/json-text-field-audit.mjs",
    "seed:demo": "tsx scripts/seed-demo-data.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.160",
    "@anthropic-ai/sdk": "^0.100.1",
    "@base-ui/react": "^1.3.0",
    "@better-auth/prisma-adapter": "^1.6.9",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.2.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "jsdom": "^26.1.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
