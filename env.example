APP_ENV=development
POSTGRES_DB=linggan_intelligence_dev
POSTGRES_USER=linggan_dev_admin
POSTGRES_PASSWORD=replace-with-a-random-local-secret
POSTGRES_PORT=55432
LINGGAN_LOCAL_PORT=3001
# Set both only after the public-origin access check and tunnel policy are verified:
# LINGGAN_PUBLIC_ORIGIN=https://intelligence.example.com
# LINGGAN_OPS_COOKIE_SECURE=1
# Optional on a host whose pinned toolchains are outside the login-shell PATH:
# LINGGAN_RUSTUP_BIN_DIR=/opt/homebrew/opt/rustup/bin
# RUSTUP_HOME=/path/to/private/toolchains/rustup
# CARGO_HOME=/path/to/private/toolchains/cargo
# LINGGAN_PI_NODE=/path/to/node-v24.13.0/bin/node
# LINGGAN_WEB_NODE=/path/to/node-v24.13.0/bin/node
DATABASE_ADMIN_URL=postgresql://linggan_dev_admin:replace-with-a-random-local-secret@127.0.0.1:55432/linggan_intelligence_dev
RUST_LOG=info

# COLLECTION-UPGRADE-001: missing/unknown keeps new acquisition paused.
# Recovery still accepts existing outbox delivery. Enable governance only after release verification.
LINGGAN_COLLECTION_UPGRADE_PHASE=recovery
