APP_ENV=development
POSTGRES_DB=linggan_intelligence_dev
POSTGRES_USER=linggan_dev_admin
POSTGRES_PASSWORD=replace-with-a-random-local-secret
POSTGRES_PORT=55432
DATABASE_ADMIN_URL=postgresql://linggan_dev_admin:replace-with-a-random-local-secret@127.0.0.1:55432/linggan_intelligence_dev
RUST_LOG=info

# COLLECTION-UPGRADE-001: missing/unknown keeps new acquisition paused.
# Recovery still accepts existing outbox delivery. Enable governance only after release verification.
LINGGAN_COLLECTION_UPGRADE_PHASE=recovery
