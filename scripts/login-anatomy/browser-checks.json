[
  [
    "until",
    "document.getElementById('station-scene').dataset.status==='running'"
  ],
  [
    "eval",
    "(()=>{const h=document.getElementById('station-scene');if(!h.querySelector('.station-live')||!h.querySelector('.station-fallback').hidden||window.__frames.size!==1)throw Error('Scene did not initialize');return {status:h.dataset.status,activeRAF:window.__frames.size}})()"
  ],
  [
    "click",
    "#submit-button"
  ],
  [
    "eval",
    "(()=>{if(document.activeElement.id!=='email'||document.getElementById('email').getAttribute('aria-invalid')!=='true')throw Error('Validation lost focus');return 'empty form validation passed'})()"
  ],
  [
    "eval",
    "document.getElementById('email').value='demo@example.com';document.getElementById('password').value='local-preview-only';document.getElementById('email').dispatchEvent(new Event('input',{bubbles:true}));document.getElementById('password').dispatchEvent(new Event('input',{bubbles:true}));"
  ],
  [
    "click",
    "#password-toggle"
  ],
  [
    "eval",
    "(()=>{if(document.getElementById('password').type!=='text')throw Error('Password visibility');return 'password toggle passed'})()"
  ],
  [
    "eval",
    "document.getElementById('password').focus()"
  ],
  [
    "wait",
    850
  ],
  [
    "eval",
    "(()=>{if(window.__authRequests!==0||document.activeElement.id!=='password')throw Error('Entry leaked focus or requests');return 'input focus and zero requests passed'})()"
  ],
  [
    "click",
    "#login-help summary"
  ],
  [
    "key",
    "Escape",
    "#login-help summary"
  ],
  [
    "eval",
    "(()=>{if(document.getElementById('login-help').open)throw Error('Help Escape');window.__testHidden=true;document.dispatchEvent(new Event('visibilitychange'));window.__savedTime=document.getElementById('station-scene').station.time;return 'hidden'})()"
  ],
  [
    "wait",
    400
  ],
  [
    "eval",
    "(()=>{const h=document.getElementById('station-scene');if(h.station.time!==window.__savedTime||window.__frames.size!==0)throw Error('Background animation active');window.__testHidden=false;document.dispatchEvent(new Event('visibilitychange'));return 'background halted'})()"
  ],
  [
    "wait",
    150
  ],
  [
    "eval",
    "(()=>{const h=document.getElementById('station-scene');if(h.station.time-window.__savedTime>.3||h.dataset.status!=='running')throw Error('Resume jumped');document.querySelector('.visual-stage').style.transform='translateY(300vh)';return 'resume retained progress'})()"
  ],
  [
    "wait",
    250
  ],
  [
    "eval",
    "(()=>{const h=document.getElementById('station-scene');if(h.dataset.status!=='paused'||window.__frames.size!==0)throw Error('Offscreen still running');document.querySelector('.visual-stage').style.transform='';return 'offscreen halted'})()"
  ],
  [
    "wait",
    200
  ],
  [
    "eval",
    "(()=>{const h=document.getElementById('station-scene');if(h.dataset.status!=='running')throw Error('Offscreen resume');h.station.destroy();if(h.querySelector('.station-live')||h.querySelector('.station-fallback').hidden||window.__frames.size!==0)throw Error('Destroy leaked');return 'resume and disposal passed'})()"
  ],
  [
    "eval",
    "document.getElementById('remember-email').checked=true"
  ],
  [
    "key",
    "Enter",
    "#password"
  ],
  [
    "until",
    "location.pathname==='/corpus/evidence'",
    10000
  ],
  [
    "eval",
    "(()=>{if(location.search||location.hash||localStorage.getItem('linggan.login.remembered-email')!=='demo@example.com'||Object.values(localStorage).some(v=>v.includes('local-preview-only')))throw Error('Development navigation or storage changed');return {path:location.pathname,emailRemembered:true,passwordStored:false}})()"
  ]
]
